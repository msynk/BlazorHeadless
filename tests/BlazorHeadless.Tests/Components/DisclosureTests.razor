@inherits TestBase

@code {
    [Fact]
    public void Disclosure_button_controls_its_panel()
    {
        var cut = Render(
            @<BhDisclosure>
                <BhDisclosureButton>Details</BhDisclosureButton>
                <BhDisclosurePanel>Hidden details</BhDisclosurePanel>
            </BhDisclosure>);

        var button = cut.Find("button");
        Assert.Equal("false", button.GetAttribute("aria-expanded"));
        // Closed panels stay in the DOM (for exit animations / find-in-page) but hidden.
        Assert.True(cut.Find($"[id='{button.GetAttribute("aria-controls")}']").HasAttribute("hidden"));

        button.Click();
        button = cut.Find("button");
        Assert.Equal("true", button.GetAttribute("aria-expanded"));
        var panel = cut.Find($"[id='{button.GetAttribute("aria-controls")}']");
        Assert.False(panel.HasAttribute("hidden"));
        Assert.Equal("Hidden details", panel.TextContent);
        cut.ShouldBeAccessible();
    }

    [Fact]
    public void Collapsible_trigger_toggles_and_reports_state()
    {
        var changes = new List<bool>();
        var cut = Render(
            @<BhCollapsible OnOpenChange="o => changes.Add(o)">
                <BhCollapsibleTrigger>More</BhCollapsibleTrigger>
                <BhCollapsibleContent>Body</BhCollapsibleContent>
            </BhCollapsible>);

        cut.Find("button").Click();
        Assert.Equal("open", cut.Find("button").GetAttribute("data-state"));
        Assert.Equal("true", cut.Find("button").GetAttribute("aria-expanded"));
        cut.Find("button").Click();
        Assert.Equal(new[] { true, false }, changes);
    }

    [Fact]
    public void Disabled_collapsible_does_not_toggle()
    {
        var cut = Render(
            @<BhCollapsible Disabled="true">
                <BhCollapsibleTrigger>More</BhCollapsibleTrigger>
                <BhCollapsibleContent>Body</BhCollapsibleContent>
            </BhCollapsible>);
        Assert.True(cut.Find("button").HasAttribute("disabled"));
        Assert.Equal("false", cut.Find("button").GetAttribute("aria-expanded"));
    }

    private RenderFragment Accordion(BhAccordionType type = BhAccordionType.Single, bool collapsible = false) =>
        @<BhAccordion Type="type" Collapsible="collapsible">
            @foreach (var (value, title) in new[] { ("a", "Shipping"), ("b", "Returns"), ("c", "Warranty") })
            {
                <BhAccordionItem Value="@value" Disabled="@(value == "b")">
                    <BhAccordionHeader>
                        <BhAccordionTrigger>@title</BhAccordionTrigger>
                    </BhAccordionHeader>
                    <BhAccordionContent>@title content</BhAccordionContent>
                </BhAccordionItem>
            }
        </BhAccordion>;

    [Fact]
    public void Accordion_triggers_are_headed_buttons_controlling_regions()
    {
        var cut = Render(Accordion());
        var triggers = cut.FindAll("button");
        Assert.Equal(3, triggers.Count);
        Assert.All(triggers, t => Assert.Equal("heading", t.ParentElement!.Role()));
        Assert.All(triggers, t => Assert.Equal("false", t.GetAttribute("aria-expanded")));

        triggers[0].Click();
        var trigger = cut.FindAll("button")[0];
        Assert.Equal("true", trigger.GetAttribute("aria-expanded"));
        var region = cut.Find($"[id='{trigger.GetAttribute("aria-controls")}']");
        Assert.Equal("region", region.GetAttribute("role"));
        Assert.Equal("Shipping", region.AccessibleName());
        cut.ShouldBeAccessible();
    }

    [Fact]
    public void Single_accordion_closes_the_other_item_and_locks_open_when_not_collapsible()
    {
        var cut = Render(Accordion());
        cut.FindAll("button")[0].Click();
        cut.FindAll("button")[2].Click();
        Assert.Equal("false", cut.FindAll("button")[0].GetAttribute("aria-expanded"));
        Assert.Equal("true", cut.FindAll("button")[2].GetAttribute("aria-expanded"));

        // Not collapsible: the open panel's trigger can't close it (aria-disabled per APG).
        cut.FindAll("button")[2].Click();
        Assert.Equal("true", cut.FindAll("button")[2].GetAttribute("aria-expanded"));
        Assert.Equal("true", cut.FindAll("button")[2].GetAttribute("aria-disabled"));
    }

    [Fact]
    public void Collapsible_single_accordion_can_close_everything()
    {
        var cut = Render(Accordion(collapsible: true));
        cut.FindAll("button")[0].Click();
        cut.FindAll("button")[0].Click();
        Assert.Equal("false", cut.FindAll("button")[0].GetAttribute("aria-expanded"));
    }

    [Fact]
    public void Multiple_accordion_keeps_several_items_open()
    {
        var cut = Render(Accordion(BhAccordionType.Multiple));
        cut.FindAll("button")[0].Click();
        cut.FindAll("button")[2].Click();
        Assert.Equal("true", cut.FindAll("button")[0].GetAttribute("aria-expanded"));
        Assert.Equal("true", cut.FindAll("button")[2].GetAttribute("aria-expanded"));
    }

    [Fact]
    public void Arrow_keys_move_between_enabled_triggers()
    {
        var cut = Render(Accordion());
        cut.FindAll("button")[0].Press("ArrowDown");
        Assert.Equal(cut.FindAll("button")[2].Id, this.LastFocusRequest());
        cut.FindAll("button")[2].Press("Home");
        Assert.Equal(cut.FindAll("button")[0].Id, this.LastFocusRequest());
        cut.FindAll("button")[0].Press("End");
        Assert.Equal(cut.FindAll("button")[2].Id, this.LastFocusRequest());
    }

    [Fact]
    public void Disabled_item_cannot_be_opened()
    {
        var cut = Render(Accordion());
        cut.FindAll("button")[1].Click();
        Assert.Equal("false", cut.FindAll("button")[1].GetAttribute("aria-expanded"));
        Assert.True(cut.FindAll("button")[1].HasAttribute("disabled") || cut.FindAll("button")[1].GetAttribute("aria-disabled") == "true");
    }
}
