<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BlazorHeadless</PackageId>
    <Version>0.1.0</Version>
    <Authors>Saleh Yusefnejad</Authors>
    <Company>msynk</Company>
    <Product>BlazorHeadless</Product>
    <Title>BlazorHeadless</Title>
    <Description>A headless UI component library for Blazor: behaviour, accessibility, and state management without any visual opinion. Includes Menu, Listbox, Combobox, Dialog, Popover, Disclosure, Accordion, Tabs, Switch, Checkbox, RadioGroup, Field, Transition, Portal, FocusTrap and more. Style it your way with plain CSS, Tailwind, or any design system.</Description>
    <Copyright>Copyright (c) 2026 Saleh Yusefnejad</Copyright>
    <PackageTags>blazor;headless;ui;components;razor;accessibility;aria;tailwind;dialog;menu;listbox;combobox;popover;disclosure;accordion;tabs;switch;checkbox;radiogroup</PackageTags>
    <PackageProjectUrl>https://github.com/msynk/BlazorHeadless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msynk/BlazorHeadless.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial preview release.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Reproducible / debuggable packages -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
