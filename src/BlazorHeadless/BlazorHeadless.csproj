<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <!-- NuGet package metadata -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackageId>BlazorHeadless</PackageId>
    <Version>0.2.0</Version>
    <Authors>Saleh Yusefnejad</Authors>
    <Company>msynk</Company>
    <Product>BlazorHeadless</Product>
    <Title>BlazorHeadless</Title>
    <Description>Accessible, unstyled UI primitives for Blazor: behaviour, keyboard interaction, focus management and WAI-ARIA semantics without any visual opinion. Dialog, AlertDialog, Popover, Tooltip, HoverCard, Menu, Menubar, ContextMenu, Listbox, Combobox, Command palette, Tree, Grid / TreeGrid, Sortable, Tabs, Accordion, Disclosure, Collapsible, Checkbox, Switch, RadioGroup, Slider, Toggle, ToggleGroup, Toolbar, Toast, Progress, Meter, Field and more. Style it with plain CSS, Tailwind, Bootstrap, Fluent or any design system.</Description>
    <Copyright>Copyright (c) 2026 Saleh Yusefnejad</Copyright>
    <PackageTags>blazor;headless;unstyled;ui;components;razor;accessibility;a11y;aria;wai-aria;keyboard;tailwind;dialog;menu;listbox;combobox;command-palette;tree;grid;sortable;slider;tabs</PackageTags>
    <PackageProjectUrl>https://github.com/msynk/BlazorHeadless</PackageProjectUrl>
    <RepositoryUrl>https://github.com/msynk/BlazorHeadless.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>See https://github.com/msynk/BlazorHeadless/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>

  <!-- Reproducible / debuggable packages -->
  <PropertyGroup>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true' or '$(TF_BUILD)' == 'true' or '$(CI)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
