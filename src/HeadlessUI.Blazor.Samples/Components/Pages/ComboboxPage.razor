@page "/combobox"
@rendermode InteractiveServer

<PageTitle>Combobox — HeadlessUI.Blazor</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Combobox</h1>
        <p>An accessible typeable autocomplete with consumer-driven filtering.</p>
    </header>

    <DemoBlock Title="Basic Combobox"
               Code="@_basicCode"
               Css="@_comboboxCss">
        <Description>
            Type to filter, use Up / Down to navigate, Enter to select, Escape to close.
            The combobox emits an <code>OnQueryChange</code> event; you do the filtering
            in your own code and pass only the matching options as children.
        </Description>
        <LiveContent>
            <HCombobox TValue="string"
                       Value="@selectedFruit"
                       OnValueChange="v => selectedFruit = v"
                       OnQueryChange="HandleFruitQuery"
                       DisplayValue="v => v ?? string.Empty"
                       class="combobox">
                <div class="combobox-input-wrapper">
                    <HComboboxInput TValue="string"
                                    Placeholder="Pick a fruit…"
                                    class="combobox-input" />
                    <HComboboxButton TValue="string" class="combobox-button" Context="b">
                        <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HComboboxButton>
                </div>
                <HComboboxOptions TValue="string" class="combobox-options">
                    @if (filteredFruits.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var fruit in filteredFruits)
                        {
                            <HComboboxOption TValue="string" Value="@fruit" class="combobox-option" Context="o">
                                <span>@fruit</span>
                                @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                            </HComboboxOption>
                        }
                    }
                </HComboboxOptions>
            </HCombobox>

            <span class="demo-output">Selected: <strong>@(selectedFruit ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multi-select with chips"
               Code="@_multiCode"
               Css="@_multiCss">
        <Description>
            Set <code>Multiple="true"</code> to allow many selections. Selected values are
            shown as chips above the input (each with a remove button). The panel stays
            open after each pick.
        </Description>
        <LiveContent>
            <HCombobox TValue="string" Multiple="true"
                       Values="@pickedTags"
                       OnValuesChange="v => pickedTags = v"
                       OnQueryChange="HandleTagQuery"
                       class="combobox">
                <div class="combobox-input-wrapper combobox-input-wrapper-multi">
                    @foreach (var tag in pickedTags)
                    {
                        <span class="combobox-chip">
                            @tag
                            <button type="button"
                                    class="combobox-chip-remove"
                                    @onclick="() => RemoveTag(tag)"
                                    aria-label="@($"Remove {tag}")">×</button>
                        </span>
                    }
                    <HComboboxInput TValue="string"
                                    Placeholder="@(pickedTags.Count == 0 ? "Pick tags…" : "")"
                                    class="combobox-input combobox-input-inline" />
                    <HComboboxButton TValue="string" class="combobox-button" Context="b">
                        <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HComboboxButton>
                </div>
                <HComboboxOptions TValue="string" class="combobox-options">
                    @if (filteredTags.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var tag in filteredTags)
                        {
                            <HComboboxOption TValue="string" Value="@tag" class="combobox-option" Context="o">
                                <span class="combobox-tick">@(o.IsSelected ? "✓" : "")</span>
                                <span>@tag</span>
                            </HComboboxOption>
                        }
                    }
                </HComboboxOptions>
            </HCombobox>

            <span class="demo-output">Picked: <strong>@(pickedTags.Count == 0 ? "(none)" : string.Join(", ", pickedTags))</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Object values with rich content"
               Code="@_objectCode"
               Css="@_objectCss">
        <Description>
            Bind to objects rather than strings. Provide a <code>DisplayValue</code> function
            that converts the selected object back to the input text, and render rich content
            inside each option.
        </Description>
        <LiveContent>
            <HCombobox TValue="Person"
                       Value="@selectedPerson"
                       OnValueChange="v => selectedPerson = v"
                       OnQueryChange="HandlePersonQuery"
                       DisplayValue="p => p?.Name ?? string.Empty"
                       class="combobox">
                <div class="combobox-input-wrapper">
                    <HComboboxInput TValue="Person"
                                    Placeholder="Search people…"
                                    class="combobox-input" />
                    <HComboboxButton TValue="Person" class="combobox-button" Context="b">
                        <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HComboboxButton>
                </div>
                <HComboboxOptions TValue="Person" class="combobox-options">
                    @if (filteredPeople.Count == 0)
                    {
                        <li class="combobox-empty">No matches.</li>
                    }
                    else
                    {
                        @foreach (var person in filteredPeople)
                        {
                            <HComboboxOption TValue="Person" Value="@person" class="combobox-option" Context="o">
                                <div class="person-row">
                                    <span class="person-avatar">@person.Initials</span>
                                    <div class="person-info">
                                        <strong>@person.Name</strong>
                                        <span>@person.Email</span>
                                    </div>
                                    @if (o.IsSelected) { <span class="combobox-tick">✓</span> }
                                </div>
                            </HComboboxOption>
                        }
                    }
                </HComboboxOptions>
            </HCombobox>

            <span class="demo-output">
                Selected: <strong>@(selectedPerson?.Name ?? "(none)")</strong>
            </span>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    // ── Single-select (fruits) ──────────────────────────────────────────────

    private string? selectedFruit;
    private string fruitQuery = string.Empty;
    private string[] allFruits = new[] {
        "Apple", "Apricot", "Banana", "Blueberry", "Cherry",
        "Coconut", "Cranberry", "Grape", "Kiwi", "Lemon",
        "Lime", "Mango", "Orange", "Papaya", "Peach",
        "Pear", "Pineapple", "Plum", "Raspberry", "Strawberry"
    };
    private List<string> filteredFruits = new();

    private void HandleFruitQuery(string query)
    {
        fruitQuery = query;
        filteredFruits = string.IsNullOrWhiteSpace(query)
            ? allFruits.ToList()
            : allFruits
                .Where(f => f.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    // ── Multi-select (tags) ─────────────────────────────────────────────────

    private IReadOnlyCollection<string> pickedTags = Array.Empty<string>();
    private string tagQuery = string.Empty;
    private string[] allTags = new[] {
        "design", "engineering", "marketing", "sales", "support",
        "research", "product", "operations", "finance", "legal"
    };
    private List<string> filteredTags = new();

    private void HandleTagQuery(string query)
    {
        tagQuery = query;
        filteredTags = string.IsNullOrWhiteSpace(query)
            ? allTags.ToList()
            : allTags
                .Where(t => t.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    private void RemoveTag(string tag)
    {
        pickedTags = pickedTags.Where(t => t != tag).ToList();
    }

    // ── Object values (people) ──────────────────────────────────────────────

    public sealed record Person(string Name, string Email)
    {
        public string Initials =>
            string.Concat(Name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                              .Take(2)
                              .Select(p => p[0]));
    }

    private Person? selectedPerson;
    private string personQuery = string.Empty;
    private Person[] allPeople = new[]
    {
        new Person("Alice Anderson",  "alice@example.com"),
        new Person("Benjamin Brown",  "ben@example.com"),
        new Person("Caterina Costa",  "cat@example.com"),
        new Person("Daniel Davis",    "dan@example.com"),
        new Person("Eleanor Evans",   "ellie@example.com"),
        new Person("Felix Foster",    "felix@example.com"),
        new Person("Genevieve Gomez", "gen@example.com"),
        new Person("Henry Hughes",    "henry@example.com"),
    };
    private List<Person> filteredPeople = new();

    private void HandlePersonQuery(string query)
    {
        personQuery = query;
        filteredPeople = string.IsNullOrWhiteSpace(query)
            ? allPeople.ToList()
            : allPeople
                .Where(p => p.Name.Contains(query, StringComparison.OrdinalIgnoreCase)
                         || p.Email.Contains(query, StringComparison.OrdinalIgnoreCase))
                .ToList();
    }

    protected override void OnInitialized()
    {
        // Seed each demo's filtered list with everything so the panel has data on first open.
        filteredFruits = allFruits.ToList();
        filteredTags   = allTags.ToList();
        filteredPeople = allPeople.ToList();
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<HCombobox TValue="string"
           Value="@selectedFruit"
           OnValueChange="v => selectedFruit = v"
           OnQueryChange="HandleFruitQuery"
           DisplayValue="v => v ?? string.Empty"
           class="combobox">
    <div class="combobox-input-wrapper">
        <HComboboxInput TValue="string"
                        Placeholder="Pick a fruit…"
                        class="combobox-input" />
        <HComboboxButton TValue="string" class="combobox-button" Context="b">
            <span class="combobox-chevron @(b.IsOpen ? "open" : "")">▾</span>
        </HComboboxButton>
    </div>
    <HComboboxOptions TValue="string" class="combobox-options">
        @if (filteredFruits.Count == 0)
        {
            <li class="combobox-empty">No matches.</li>
        }
        else
        {
            @foreach (var fruit in filteredFruits)
            {
                <HComboboxOption TValue="string" Value="@fruit" class="combobox-option">
                    @fruit
                </HComboboxOption>
            }
        }
    </HComboboxOptions>
</HCombobox>

@code {
    private string? selectedFruit;
    private List<string> filteredFruits = …;

    private void HandleFruitQuery(string q) =>
        filteredFruits = allFruits.Where(f => f.Contains(q, StringComparison.OrdinalIgnoreCase)).ToList();
}
""";

    private const string _multiCode = """
<HCombobox TValue="string" Multiple="true"
           Values="@pickedTags"
           OnValuesChange="v => pickedTags = v"
           OnQueryChange="HandleTagQuery"
           class="combobox">
    <div class="combobox-input-wrapper combobox-input-wrapper-multi">
        @foreach (var tag in pickedTags)
        {
            <span class="combobox-chip">
                @tag
                <button type="button"
                        class="combobox-chip-remove"
                        @onclick="() => RemoveTag(tag)"
                        aria-label="@($"Remove {tag}")">×</button>
            </span>
        }
        <HComboboxInput TValue="string" class="combobox-input combobox-input-inline" />
        <HComboboxButton TValue="string" class="combobox-button">…</HComboboxButton>
    </div>
    <HComboboxOptions TValue="string" class="combobox-options">
        @* …filtered options with check marks for selected items… *@
    </HComboboxOptions>
</HCombobox>
""";

    private const string _objectCode = """
public sealed record Person(string Name, string Email);

<HCombobox TValue="Person"
           Value="@selectedPerson"
           OnValueChange="v => selectedPerson = v"
           OnQueryChange="HandlePersonQuery"
           DisplayValue="p => p?.Name ?? string.Empty"
           class="combobox">
    <HComboboxInput TValue="Person" class="combobox-input" />
    <HComboboxOptions TValue="Person" class="combobox-options">
        @foreach (var person in filteredPeople)
        {
            <HComboboxOption TValue="Person" Value="@person" class="combobox-option">
                <div class="person-row">
                    <span class="person-avatar">@person.Initials</span>
                    <div class="person-info">
                        <strong>@person.Name</strong>
                        <span>@person.Email</span>
                    </div>
                </div>
            </HComboboxOption>
        }
    </HComboboxOptions>
</HCombobox>
""";

    private const string _comboboxCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.combobox          { position: relative; display: inline-block; min-width: 18rem; }

.combobox-input-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    transition: border-color 120ms ease;
}

.combobox-input-wrapper:focus-within { border-color: #2563eb; }

.combobox-input {
    flex: 1 1 auto;
    padding: 0.5rem 0.85rem;
    border: 0;
    background: transparent;
    font-size: 0.9rem;
    font-family: inherit;
    color: #18181b;
    outline: none;
}

.combobox-button {
    all: unset;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 0.65rem;
    cursor: pointer;
    color: #71717a;
}

.combobox-chevron       { transition: transform 200ms ease; }
.combobox-chevron.open  { transform: rotate(180deg); }

/* Options panel — sits above the click-outside overlay (z-index: 30 inline) */
.combobox-options {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    right: 0;
    z-index: 31;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    max-height: 16rem;
    overflow-y: auto;
}

.combobox-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    cursor: pointer;
    color: #18181b;
}

/* Hooks emitted by HComboboxOption */
.combobox-option[data-active]   { background: #eff6ff; }
.combobox-option[data-selected] { font-weight: 600; }
.combobox-option[data-disabled] { opacity: 0.4; cursor: not-allowed; }

.combobox-empty {
    padding: 0.6rem 0.65rem;
    font-size: 0.85rem;
    color: #71717a;
    font-style: italic;
}

.combobox-tick { color: #2563eb; font-weight: 700; }
""";

    private const string _multiCss = """
/* Builds on the .combobox styles from the Basic demo. Adds the chips. */
.combobox-input-wrapper-multi {
    flex-wrap: wrap;
    padding: 0.25rem 0.35rem;
    gap: 0.25rem;
}

.combobox-input-inline {
    width: auto;
    min-width: 6rem;
    padding: 0.25rem 0.4rem;
}

.combobox-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.15rem 0.5rem;
    background: #eff6ff;
    color: #1d4ed8;
    border-radius: 999px;
    font-size: 0.78rem;
    font-weight: 600;
}

.combobox-chip-remove {
    all: unset;
    cursor: pointer;
    font-size: 1rem;
    line-height: 0.7;
    padding: 0 0.1rem;
    border-radius: 999px;
}

.combobox-chip-remove:hover { background: #dbeafe; }
""";

    private const string _objectCss = """
/* Rich-content option for an object-typed combobox */
.person-row {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
}

.person-avatar {
    width: 1.75rem;
    height: 1.75rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    background: #e0e7ff;
    color: #1d4ed8;
    font-size: 0.7rem;
    font-weight: 700;
}

.person-info {
    flex: 1 1 auto;
    display: flex;
    flex-direction: column;
    line-height: 1.25;
}

.person-info strong { font-size: 0.85rem; color: #18181b; }
.person-info span   { font-size: 0.75rem; color: #71717a; }
""";
}
