@page "/listbox"
@rendermode InteractiveServer

<PageTitle>Listbox — HeadlessUI.Blazor</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Listbox</h1>
        <p>An accessible custom select with single/multi-select, full keyboard navigation, and typeahead.</p>
    </header>

    <DemoBlock Title="Basic Listbox"
               Code="@_basicCode"
               Css="@_listboxCss">
        <Description>
            Click the button or press Space / Enter / arrow keys to open. Use Up / Down to navigate,
            Home / End to jump, Enter / Space to select, Escape to close, or simply type to jump
            to an option. ARIA wiring (<code>combobox</code>, <code>listbox</code>,
            <code>aria-activedescendant</code>) is handled for you.
        </Description>
        <LiveContent>
            <HListbox TValue="string" Value="@favPerson"
                      OnValueChange="v => favPerson = v"
                      class="listbox">
                <HListboxButton TValue="string" class="listbox-button" Context="b">
                    <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
                    <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HListboxButton>
                <HListboxOptions TValue="string" class="listbox-options">
                    @foreach (var name in people)
                    {
                        <HListboxOption TValue="string" Value="@name" class="listbox-option">@name</HListboxOption>
                    }
                </HListboxOptions>
            </HListbox>

            <span class="demo-output">Selected: <strong>@(favPerson ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multi-select"
               Code="@_multiCode"
               Css="@_multiCss">
        <Description>
            Set <code>Multiple="true"</code> to allow selecting many values. The panel stays
            open after each selection. The button label here renders the joined names.
        </Description>
        <LiveContent>
            <HListbox TValue="string" Multiple="true"
                      Values="@favColors"
                      OnValuesChange="v => favColors = v"
                      class="listbox">
                <HListboxButton TValue="string" class="listbox-button" Context="b">
                    <span>
                        @(b.Values.Count == 0 ? "Pick colours…" : string.Join(", ", b.Values))
                    </span>
                    <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HListboxButton>
                <HListboxOptions TValue="string" class="listbox-options">
                    @foreach (var c in colors)
                    {
                        <HListboxOption TValue="string" Value="@c" class="listbox-option" Context="o">
                            <span class="check-mark">@(o.IsSelected ? "✓" : "")</span>
                            <span>@c</span>
                        </HListboxOption>
                    }
                </HListboxOptions>
            </HListbox>

            <span class="demo-output">Selected: <strong>@string.Join(", ", favColors)</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Options"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Mark individual options with <code>Disabled="true"</code>. They render with
            <code>data-disabled</code> for CSS, are skipped by arrow-key nav, and ignore typeahead matches.
        </Description>
        <LiveContent>
            <HListbox TValue="string" DefaultValue='@("standard")' class="listbox">
                <HListboxButton TValue="string" class="listbox-button" Context="b">
                    <span>@(b.Value ?? "Pick a plan")</span>
                    <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HListboxButton>
                <HListboxOptions TValue="string" class="listbox-options">
                    <HListboxOption TValue="string" Value="@("standard")" class="listbox-option">Standard</HListboxOption>
                    <HListboxOption TValue="string" Value="@("pro")" class="listbox-option">Pro</HListboxOption>
                    <HListboxOption TValue="string" Value="@("enterprise")" Disabled="true" class="listbox-option">
                        Enterprise (coming soon)
                    </HListboxOption>
                </HListboxOptions>
            </HListbox>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Custom Option Content"
               Code="@_customCode"
               Css="@_customCss">
        <Description>
            Options can render any markup. Use the <code>data-active</code> and
            <code>data-selected</code> hooks to drive the highlighted and selected styles.
            Provide a <code>Label</code> string when your content is rich so typeahead
            still matches sensibly.
        </Description>
        <LiveContent>
            <HListbox TValue="string" Value="@country"
                      OnValueChange="v => country = v"
                      class="listbox">
                <HListboxButton TValue="string" class="listbox-button" Context="b">
                    <span>@(LookupCountry(b.Value)?.Name ?? "Pick a country")</span>
                    <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HListboxButton>
                <HListboxOptions TValue="string" class="listbox-options">
                    @foreach (var c in countries)
                    {
                        <HListboxOption TValue="string" Value="@c.Code" Label="@c.Name" class="listbox-option">
                            <span class="country-flag">@c.Flag</span>
                            <span class="country-name">@c.Name</span>
                            <span class="country-code">@c.Code</span>
                        </HListboxOption>
                    }
                </HListboxOptions>
            </HListbox>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Anchor Positioning"
               Code="@_anchorCode"
               Css="@_anchorCss">
        <Description>
            Set <code>Anchor</code> on <code>HListboxOptions</code> to automatically position
            the dropdown relative to the button using <code>position: fixed</code>. The panel
            flips to the opposite side when there's not enough space, shifts to stay within
            the viewport, and auto-updates on scroll/resize. The CSS variable
            <code>--button-width</code> is exposed so you can match the dropdown width to the trigger.
            No <code>position: relative</code> on the parent is needed.
        </Description>
        <LiveContent>
            <div style="display:flex; gap:2rem; flex-wrap:wrap; align-items:flex-end;">
                <div>
                    <p style="font-size:0.8rem; color:#71717a; margin:0 0 0.5rem;">Bottom Start (width matched)</p>
                    <HListbox TValue="string" Value="@anchorPerson"
                              OnValueChange="v => anchorPerson = v"
                              class="listbox-anchored">
                        <HListboxButton TValue="string" class="listbox-button" Context="b">
                            <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
                            <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </HListboxButton>
                        <HListboxOptions TValue="string"
                                         Anchor="@(new AnchorOptions { To = "bottom start", Gap = 4 })"
                                         class="listbox-options-anchored">
                            @foreach (var name in people)
                            {
                                <HListboxOption TValue="string" Value="@name" class="listbox-option">@name</HListboxOption>
                            }
                        </HListboxOptions>
                    </HListbox>
                </div>

                <div>
                    <p style="font-size:0.8rem; color:#71717a; margin:0 0 0.5rem;">Top Start (flips down if no space)</p>
                    <HListbox TValue="string" Value="@anchorPerson2"
                              OnValueChange="v => anchorPerson2 = v"
                              class="listbox-anchored">
                        <HListboxButton TValue="string" class="listbox-button" Context="b">
                            <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
                            <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                        </HListboxButton>
                        <HListboxOptions TValue="string"
                                         Anchor="@(new AnchorOptions { To = "top start", Gap = 4 })"
                                         class="listbox-options-anchored">
                            @foreach (var name in people)
                            {
                                <HListboxOption TValue="string" Value="@name" class="listbox-option">@name</HListboxOption>
                            }
                        </HListboxOptions>
                    </HListbox>
                </div>
            </div>

            <span class="demo-output" style="margin-top:0.75rem;">
                Selected: <strong>@(anchorPerson ?? anchorPerson2 ?? "(none)")</strong>
            </span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Form Submission"
               Code="@_formCode"
               Css="@_formCss">
        <Description>
            Set <code>Name</code> on the listbox and the selection participates in plain HTML
            form posts. In multi-select mode a separate hidden input is rendered for each value.
        </Description>
        <LiveContent>
            <form @onsubmit="HandleFormSubmit"
                  @onsubmit:preventDefault="true"
                  style="display:flex; flex-direction:column; gap:0.75rem; align-items:flex-start;">
                <HListbox TValue="string" Name="role" DefaultValue='@("user")' class="listbox">
                    <HListboxButton TValue="string" class="listbox-button" Context="b">
                        <span>@(b.Value)</span>
                        <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HListboxButton>
                    <HListboxOptions TValue="string" class="listbox-options">
                        <HListboxOption TValue="string" Value="@("user")" class="listbox-option">User</HListboxOption>
                        <HListboxOption TValue="string" Value="@("admin")" class="listbox-option">Admin</HListboxOption>
                        <HListboxOption TValue="string" Value="@("owner")" class="listbox-option">Owner</HListboxOption>
                    </HListboxOptions>
                </HListbox>

                <button type="submit" class="btn btn-primary">Submit</button>

                @if (lastSubmitted is not null)
                {
                    <span class="demo-output">@lastSubmitted</span>
                }
            </form>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private string? favPerson;
    private string? anchorPerson;
    private string? anchorPerson2;
    private IReadOnlyCollection<string> favColors = Array.Empty<string>();
    private string? country = "fr";
    private string? lastSubmitted;

    private string[] people = new[] {
        "Alice", "Benjamin", "Caterina", "Daniel",
        "Eleanor", "Felix", "Genevieve", "Henry"
    };

    private string[] colors = new[] {
        "Red", "Green", "Blue", "Yellow", "Purple", "Orange"
    };

    private record Country(string Code, string Name, string Flag);
    private Country[] countries = new[]
    {
        new Country("us", "United States", "🇺🇸"),
        new Country("gb", "United Kingdom", "🇬🇧"),
        new Country("fr", "France",         "🇫🇷"),
        new Country("de", "Germany",        "🇩🇪"),
        new Country("jp", "Japan",          "🇯🇵"),
        new Country("br", "Brazil",         "🇧🇷"),
    };

    private Country? LookupCountry(string? code) =>
        code is null ? null : countries.FirstOrDefault(c => c.Code == code);

    private void HandleFormSubmit()
    {
        lastSubmitted = "(submitted — when single-select, posts role=<value>; when multi-select, posts a separate field per value)";
    }

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<HListbox TValue="string" Value="@favPerson"
          OnValueChange="v => favPerson = v"
          class="listbox">
    <HListboxButton TValue="string" class="listbox-button" Context="b">
        <span>@(string.IsNullOrEmpty(b.Value) ? "Select a person…" : b.Value)</span>
        <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
    </HListboxButton>
    <HListboxOptions TValue="string" class="listbox-options">
        @foreach (var name in people)
        {
            <HListboxOption TValue="string" Value="@name" class="listbox-option">
                @name
            </HListboxOption>
        }
    </HListboxOptions>
</HListbox>

@code {
    private string? favPerson;
    private string[] people = ["Alice", "Benjamin", "Caterina", "…"];
}
""";

    private const string _multiCode = """
<HListbox TValue="string" Multiple="true"
          Values="@favColors"
          OnValuesChange="v => favColors = v"
          class="listbox">
    <HListboxButton TValue="string" class="listbox-button" Context="b">
        <span>
            @(b.Values.Count == 0 ? "Pick colours…" : string.Join(", ", b.Values))
        </span>
    </HListboxButton>
    <HListboxOptions TValue="string" class="listbox-options">
        @foreach (var c in colors)
        {
            <HListboxOption TValue="string" Value="@c" class="listbox-option" Context="o">
                <span class="check-mark">@(o.IsSelected ? "✓" : "")</span>
                <span>@c</span>
            </HListboxOption>
        }
    </HListboxOptions>
</HListbox>
""";

    private const string _disabledCode = """
<HListbox TValue="string" DefaultValue="standard" class="listbox">
    <HListboxButton TValue="string" class="listbox-button">…</HListboxButton>
    <HListboxOptions TValue="string" class="listbox-options">
        <HListboxOption TValue="string" Value="standard"   class="listbox-option">Standard</HListboxOption>
        <HListboxOption TValue="string" Value="pro"        class="listbox-option">Pro</HListboxOption>
        <HListboxOption TValue="string" Value="enterprise" Disabled="true" class="listbox-option">
            Enterprise (coming soon)
        </HListboxOption>
    </HListboxOptions>
</HListbox>
""";

    private const string _customCode = """
<HListbox TValue="string" Value="@country"
          OnValueChange="v => country = v"
          class="listbox">
    <HListboxButton TValue="string" class="listbox-button" Context="b">
        <span>@(LookupCountry(b.Value)?.Name ?? "Pick a country")</span>
    </HListboxButton>
    <HListboxOptions TValue="string" class="listbox-options">
        @foreach (var c in countries)
        {
            <HListboxOption TValue="string" Value="@c.Code"
                            Label="@c.Name"
                            class="listbox-option">
                <span class="country-flag">@c.Flag</span>
