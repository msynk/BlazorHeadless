                <span class="country-code">@c.Code</span>
            </HListboxOption>
        }
    </HListboxOptions>
</HListbox>
""";

    private const string _formCode = """
<form method="post">
    <HListbox TValue="string" Name="role" DefaultValue="user" class="listbox">
        <HListboxButton TValue="string" class="listbox-button">…</HListboxButton>
        <HListboxOptions TValue="string" class="listbox-options">
            <HListboxOption TValue="string" Value="user"  class="listbox-option">User</HListboxOption>
            <HListboxOption TValue="string" Value="admin" class="listbox-option">Admin</HListboxOption>
            <HListboxOption TValue="string" Value="owner" class="listbox-option">Owner</HListboxOption>
        </HListboxOptions>
    </HListbox>
    <button type="submit">Submit</button>
</form>

@* When Multiple="true" a separate hidden input is rendered per selected value. *@
""";

    private const string _listboxCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.listbox          { position: relative; display: inline-block; min-width: 14rem; }

.listbox-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem 0.85rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    cursor: pointer;
}

.listbox-button:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.listbox-button[data-state="open"]  { border-color: #2563eb; }
.listbox-button[data-disabled]      { opacity: 0.5; cursor: not-allowed; }

.listbox-chevron        { transition: transform 200ms ease; color: #71717a; }
.listbox-chevron.open   { transform: rotate(180deg); }

/* Options panel — sits above the click-outside overlay (z-index: 31). */
.listbox-options {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    right: 0;
    z-index: 31;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    max-height: 14rem;
    overflow-y: auto;
}

.listbox-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.45rem 0.65rem;
    border-radius: 0.35rem;
    font-size: 0.9rem;
    cursor: pointer;
    color: #18181b;
}

/* Hooks emitted by HListboxOption */
.listbox-option[data-active]   { background: #eff6ff; }
.listbox-option[data-selected] { font-weight: 600; }
.listbox-option[data-disabled] { opacity: 0.4; cursor: not-allowed; }
""";

    private const string _multiCss = """
/* Reuses the .listbox / .listbox-option styles from the Basic demo.
   The check-mark glyph is shown for selected options. */
.check-mark {
    display: inline-block;
    width: 1rem;
    color: #2563eb;
    font-weight: 700;
}
""";

    private const string _disabledCss = """
/* Hooks emitted when an option is disabled */
.listbox-option[data-disabled] {
    opacity: 0.4;
    cursor: not-allowed;
}

/* Arrow-key navigation and typeahead skip disabled options. */
""";

    private const string _customCss = """
/* Rich option layout: flag + name + code */
.country-flag { font-size: 1.05rem; }
.country-name { flex: 1 1 auto; }
.country-code {
    font-size: 0.7rem;
    color: #71717a;
    text-transform: uppercase;
    letter-spacing: 0.05em;
}

/* Provide Label="@c.Name" on each option so typeahead matches the visible
   country name rather than the country code stored as the value. */
""";

    private const string _formCss = """
/* Reuses the .listbox styles from earlier demos.
   When Name is set, HListbox renders <input type="hidden"> sibling(s) — one for
   single-select, or one per value for multi-select. */
""";

    private const string _anchorCode = """
@* Anchor positions the dropdown relative to the button automatically.
   No position:relative on parent or position:absolute on panel needed.
   The panel uses position:fixed and auto-updates on scroll/resize. *@

<HListbox TValue="string" Value="@person"
          OnValueChange="v => person = v"
          class="listbox-anchored">
    <HListboxButton TValue="string" class="listbox-button" Context="b">
        <span>@(b.Value ?? "Select a person…")</span>
        <span class="listbox-chevron @(b.IsOpen ? "open" : "")">▾</span>
    </HListboxButton>
    <HListboxOptions TValue="string"
                     Anchor="@(new AnchorOptions { To = "bottom start", Gap = 4 })"
                     class="listbox-options-anchored">
        @foreach (var name in people)
        {
            <HListboxOption TValue="string" Value="@name" class="listbox-option">
                @name
            </HListboxOption>
        }
    </HListboxOptions>
</HListbox>

@* Available placements: top, top start, top end,
   bottom, bottom start, bottom end,
   left, left start, left end,
   right, right start, right end

   The panel auto-flips to the opposite side if there's not enough space.
   Use --button-width CSS variable to match the trigger width. *@
""";

    private const string _anchorCss = """
/* When using Anchor, the panel is position:fixed by the JS engine.
   No position:relative on parent needed. */
.listbox-anchored { display: inline-block; min-width: 14rem; }

.listbox-options-anchored {
    z-index: 9999;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 6px 16px rgba(0, 0, 0, 0.08);
    max-height: 14rem;
    overflow-y: auto;
    /* Match the button width using the exposed CSS variable */
    width: var(--button-width);
}

/* Explicit hidden override — required when the panel has display set */
.listbox-options-anchored[hidden] { display: none; }
""";
}
