</HPopoverGroup>

@* Opening one popover automatically closes the others. *@
""";

    private const string _controlledCode = """
<HPopover Open="controlledOpen"
          OnOpenChange="v => controlledOpen = v"
          class="popover">
    <HPopoverButton class="popover-button" Context="b">
        Internal trigger
        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
    </HPopoverButton>
    <HPopoverPanel class="popover-panel">…</HPopoverPanel>
</HPopover>

@code {
    private bool controlledOpen;
}
""";

    private const string _richCode = """
<HPopover class="popover">
    <HPopoverButton class="popover-button" Context="b">
        Notifications
        <span class="popover-badge">3</span>
    </HPopoverButton>
    <HPopoverPanel class="popover-panel popover-panel-wide">
        <div class="popover-header">
            <h3 class="popover-title">Notifications</h3>
        </div>
        <ul class="notification-list">
            <li class="notification-item">…</li>
        </ul>
        <a href="#" class="popover-footer-link">View all →</a>
    </HPopoverPanel>
</HPopover>
""";

    private const string _anchorCode = """
@* Anchor positions the panel relative to the button automatically.
   Supports all sides: top, right, bottom, left — with start/end alignment. *@

<HPopover class="popover-anchored">
    <HPopoverButton class="popover-button" Context="b">
        Bottom Start ▾
    </HPopoverButton>
    <HPopoverPanel Anchor="@(new AnchorOptions { To = "bottom start", Gap = 8 })"
                   class="popover-panel-anchored" Context="p">
        <p>This panel is anchored with auto-flip and shift.</p>
    </HPopoverPanel>
</HPopover>

@* Available placements: top, top start, top end,
   bottom, bottom start, bottom end,
   left, left start, left end,
   right, right start, right end *@
""";

    private const string _anchorCss = """
/* When using Anchor, the panel is position:fixed by the JS engine.
   No position:relative on parent needed. */
.popover-anchored { display: inline-block; }

.popover-panel-anchored {
    z-index: 31;
    min-width: 16rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    padding: 1rem;
}
""";

    private const string _popoverCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.popover { position: relative; display: inline-block; }

.popover-button {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid #d4d4d8;
    border-radius: 0.5rem;
    background: #fff;
    font-size: 0.9rem;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 120ms ease;
}

.popover-button:hover               { border-color: #a1a1af; }
.popover-button:focus-visible       { outline: 2px solid #2563eb; outline-offset: 2px; }
.popover-button[data-state="open"]  { border-color: #2563eb; }

.popover-chevron       { transition: transform 200ms ease; color: #71717a; }
.popover-chevron.open  { transform: rotate(180deg); }

/* Panel — sits above the click-outside overlay (z-index: 30 inline) */
.popover-panel {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    z-index: 31;
    min-width: 16rem;
    background: #fff;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
}

.popover-title  { font-size: 0.95rem; font-weight: 600; color: #18181b; margin: 0; }
.popover-body   { font-size: 0.875rem; color: #71717a; margin: 0; }
.popover-link   { font-size: 0.875rem; color: #2563eb; text-decoration: none; }
.popover-link:hover { text-decoration: underline; }

.popover-close-btn {
    all: unset;
    font-size: 0.8rem;
    color: #71717a;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
}
""";

    private const string _groupCss = """
/* Wrap popovers in a flex row for a nav-bar layout */
.popover-group {
    display: flex;
    gap: 0.5rem;
    align-items: center;
}

/* Opening one popover closes the others — no extra CSS needed. */
""";

    private const string _controlledCss = """
/* Reuses the .popover / .popover-panel styles from the Basic demo.
   Controlled mode adds no new CSS hooks — data-state simply reflects
   whatever Open value you bind to. */
""";

    private const string _richCss = """
.popover-panel-wide { min-width: 22rem; padding: 0; overflow: hidden; }

.popover-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid #e4e4e7;
}

.popover-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.1rem 0.45rem;
    background: #2563eb;
    color: #fff;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
}

.notification-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
}

.notification-item {
    display: flex;
    align-items: flex-start;
    gap: 0.65rem;
    padding: 0.6rem 1rem;
    transition: background 120ms ease;
}

.notification-item:hover { background: #f4f4f5; }

.notification-dot {
    width: 0.5rem;
    height: 0.5rem;
    background: #2563eb;
    border-radius: 999px;
    flex-shrink: 0;
    margin-top: 0.3rem;
}

.notification-item div {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
}

.notification-item strong { font-size: 0.85rem; color: #18181b; }
.notification-item span   { font-size: 0.75rem; color: #71717a; }

.popover-footer-link {
    display: block;
    padding: 0.6rem 1rem;
    font-size: 0.85rem;
    color: #2563eb;
    text-decoration: none;
    border-top: 1px solid #e4e4e7;
    text-align: center;
}

.popover-footer-link:hover { background: #f4f4f5; }
""";
}
