@page "/popover"
@rendermode InteractiveServer

<PageTitle>Popover — HeadlessUI.Blazor</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Popover</h1>
        <p>A non-modal floating panel with focus management, Escape-to-close, and group coordination.</p>
    </header>

    <DemoBlock Title="Basic Popover"
               Code="@_basicCode"
               Css="@_popoverCss">
        <Description>
            Click the button to open the panel. Focus moves into the panel automatically.
            Press Escape or click outside to close — focus returns to the button.
            Unlike a Dialog, the rest of the page stays interactive.
        </Description>
        <LiveContent>
            <HPopover class="popover">
                <HPopoverButton class="popover-button" Context="b">
                    Learn more
                    <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HPopoverButton>
                <HPopoverPanel class="popover-panel" Context="p">
                    <h3 class="popover-title">HeadlessUI.Blazor</h3>
                    <p class="popover-body">
                        A headless component library for Blazor. Zero styles, full accessibility,
                        complete control over your design.
                    </p>
                    <a href="https://github.com" target="_blank" class="popover-link">
                        View on GitHub →
                    </a>
                    <HPopoverButton class="popover-close-btn">Close</HPopoverButton>
                </HPopoverPanel>
            </HPopover>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Popover Group (mutual exclusion)"
               Code="@_groupCode"
               Css="@_groupCss">
        <Description>
            Wrap multiple popovers in an <code>HPopoverGroup</code> so opening one
            automatically closes the others. Useful for navigation bars.
        </Description>
        <LiveContent>
            <HPopoverGroup class="popover-group">
                <HPopover class="popover">
                    <HPopoverButton class="popover-button" Context="b">
                        Products
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel class="popover-panel">
                        <h3 class="popover-title">Products</h3>
                        <ul class="popover-nav-list">
                            <li><a href="#" class="popover-nav-link">Analytics</a></li>
                            <li><a href="#" class="popover-nav-link">Automation</a></li>
                            <li><a href="#" class="popover-nav-link">Commerce</a></li>
                        </ul>
                    </HPopoverPanel>
                </HPopover>

                <HPopover class="popover">
                    <HPopoverButton class="popover-button" Context="b">
                        Solutions
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel class="popover-panel">
                        <h3 class="popover-title">Solutions</h3>
                        <ul class="popover-nav-list">
                            <li><a href="#" class="popover-nav-link">Marketing</a></li>
                            <li><a href="#" class="popover-nav-link">Engineering</a></li>
                            <li><a href="#" class="popover-nav-link">Finance</a></li>
                        </ul>
                    </HPopoverPanel>
                </HPopover>

                <HPopover class="popover">
                    <HPopoverButton class="popover-button" Context="b">
                        Company
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel class="popover-panel">
                        <h3 class="popover-title">Company</h3>
                        <ul class="popover-nav-list">
                            <li><a href="#" class="popover-nav-link">About</a></li>
                            <li><a href="#" class="popover-nav-link">Blog</a></li>
                            <li><a href="#" class="popover-nav-link">Careers</a></li>
                        </ul>
                    </HPopoverPanel>
                </HPopover>
            </HPopoverGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Controlled"
               Code="@_controlledCode"
               Css="@_controlledCss">
        <Description>
            Drive the open state externally with <code>Open</code> and
            <code>OnOpenChange</code>. The button below opens or closes the popover
            programmatically.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <div class="demo-row">
                    <HButton OnClick="ToggleControlled" class="btn">
                        Toggle from outside
                    </HButton>
                    <span class="demo-output">Open: <strong>@controlledOpen.ToString().ToLowerInvariant()</strong></span>
                </div>

                <HPopover Open="controlledOpen"
                          OnOpenChange="v => controlledOpen = v"
                          class="popover">
                    <HPopoverButton class="popover-button" Context="b">
                        Internal trigger
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel class="popover-panel">
                        <p class="popover-body">
                            Either trigger updates the same state — fully controlled.
                        </p>
                    </HPopoverPanel>
                </HPopover>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Anchor Positioning"
               Code="@_anchorCode"
               Css="@_anchorCss">
        <Description>
            Set <code>Anchor</code> on <code>HPopoverPanel</code> to automatically position
            the panel relative to the button. The panel uses <code>position: fixed</code>,
            flips when there's not enough space, and auto-updates on scroll/resize.
            No <code>position: relative</code> on the parent or <code>position: absolute</code>
            on the panel needed.
        </Description>
        <LiveContent>
            <div style="display:flex; gap:1.5rem; flex-wrap:wrap; align-items:flex-start;">
                <HPopover class="popover-anchored">
                    <HPopoverButton class="popover-button" Context="b">
                        Bottom Start
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel Anchor="@(new AnchorOptions { To = "bottom start", Gap = 8 })"
                                   class="popover-panel-anchored" Context="p">
                        <p class="popover-body">
                            This panel is anchored to <strong>bottom start</strong> with an 8px gap.
                            It will flip to the top if there's not enough space below.
                        </p>
                    </HPopoverPanel>
                </HPopover>

                <HPopover class="popover-anchored">
                    <HPopoverButton class="popover-button" Context="b">
                        Top End
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel Anchor="@(new AnchorOptions { To = "top end", Gap = 8 })"
                                   class="popover-panel-anchored" Context="p">
                        <p class="popover-body">
                            This panel is anchored to <strong>top end</strong>. It flips to the
                            bottom if there's not enough space above.
                        </p>
                    </HPopoverPanel>
                </HPopover>

                <HPopover class="popover-anchored">
                    <HPopoverButton class="popover-button" Context="b">
                        Right
                        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                    </HPopoverButton>
                    <HPopoverPanel Anchor="@(new AnchorOptions { To = "right", Gap = 8 })"
                                   class="popover-panel-anchored" Context="p">
                        <p class="popover-body">
                            This panel is anchored to the <strong>right</strong> side.
                        </p>
                    </HPopoverPanel>
                </HPopover>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Rich panel content"
               Code="@_richCode"
               Css="@_richCss">
        <Description>
            The panel can contain any content — forms, images, links, nested interactive
            elements. Tab navigates freely inside and out (no focus trap).
        </Description>
        <LiveContent>
            <HPopover class="popover">
                <HPopoverButton class="popover-button" Context="b">
                    Notifications
                    <span class="popover-badge">3</span>
                    <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
                </HPopoverButton>
                <HPopoverPanel class="popover-panel popover-panel-wide">
                    <div class="popover-header">
                        <h3 class="popover-title">Notifications</h3>
                        <span class="popover-badge">3 new</span>
                    </div>
                    <ul class="notification-list">
                        <li class="notification-item">
                            <span class="notification-dot"></span>
                            <div>
                                <strong>Alice commented on your post</strong>
                                <span>2 minutes ago</span>
                            </div>
                        </li>
                        <li class="notification-item">
                            <span class="notification-dot"></span>
                            <div>
                                <strong>Your export is ready</strong>
                                <span>15 minutes ago</span>
                            </div>
                        </li>
                        <li class="notification-item">
                            <span class="notification-dot"></span>
                            <div>
                                <strong>New team member joined</strong>
                                <span>1 hour ago</span>
                            </div>
                        </li>
                    </ul>
                    <a href="#" class="popover-footer-link">View all notifications →</a>
                </HPopoverPanel>
            </HPopover>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private bool controlledOpen;

    private void ToggleControlled() => controlledOpen = !controlledOpen;

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<HPopover class="popover">
    <HPopoverButton class="popover-button" Context="b">
        Learn more
        <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
    </HPopoverButton>
    <HPopoverPanel class="popover-panel" Context="p">
        <h3 class="popover-title">HeadlessUI.Blazor</h3>
        <p class="popover-body">…</p>

        @* HPopoverButton inside the panel acts as a Close button *@
        <HPopoverButton class="popover-close-btn">Close</HPopoverButton>
    </HPopoverPanel>
</HPopover>
""";

    private const string _groupCode = """
<HPopoverGroup class="popover-group">
    <HPopover class="popover">
        <HPopoverButton class="popover-button" Context="b">
            Products
            <span class="popover-chevron @(b.IsOpen ? "open" : "")">▾</span>
