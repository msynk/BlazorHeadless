@*
    Reusable wrapper that renders a section heading, an optional description, and
    a tabbed view with Preview / Razor / CSS panels. Uses the library's own HTabGroup
    so the demo app dogfoods the headless tab component.
*@

<section class="demo-section">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <h2>@Title</h2>
    }
    @if (Description is not null)
    {
        <p>@Description</p>
    }

    <HTabGroup class="demo-tabs">
        <HTabList class="demo-tab-list">
            @if (LiveContent is not null)
            {
                <HTab class="demo-tab">Preview</HTab>
            }
            @if (!string.IsNullOrWhiteSpace(Code))
            {
                <HTab class="demo-tab">Razor</HTab>
            }
            @if (!string.IsNullOrWhiteSpace(Css))
            {
                <HTab class="demo-tab">CSS</HTab>
            }
        </HTabList>
        <HTabPanels class="demo-tab-panels">
            @if (LiveContent is not null)
            {
                <HTabPanel class="demo-tab-panel">
                    <div class="demo-row">
                        @LiveContent
                    </div>
                </HTabPanel>
            }
            @if (!string.IsNullOrWhiteSpace(Code))
            {
                <HTabPanel class="demo-tab-panel">
                    <pre class="demo-code"><code>@Code.Trim('\r', '\n')</code></pre>
                </HTabPanel>
            }
            @if (!string.IsNullOrWhiteSpace(Css))
            {
                <HTabPanel class="demo-tab-panel">
                    <pre class="demo-code"><code>@Css.Trim('\r', '\n')</code></pre>
                </HTabPanel>
            }
        </HTabPanels>
    </HTabGroup>
</section>

@code {
    [Parameter] public string? Title { get; set; }
    [Parameter] public RenderFragment? Description { get; set; }
    [Parameter] public RenderFragment? LiveContent { get; set; }

    /// <summary>The Razor markup used by the demo.</summary>
    [Parameter] public string? Code { get; set; }

    /// <summary>The CSS that styles the demo. Optional.</summary>
    [Parameter] public string? Css { get; set; }
}
