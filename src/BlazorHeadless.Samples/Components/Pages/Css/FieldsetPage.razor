@page "/fieldset"
@rendermode InteractiveServer

<PageTitle>Fieldset — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Fieldset</h1>
        <p>
            Group a set of form controls together with a fully accessible but
            much easier-to-style version of the native <code>fieldset</code> and
            <code>legend</code> elements.
        </p>
        <SectionSwitcher Slug="fieldset" />
    </header>

    <DemoBlock Title="Basic example"
               Code="@_basicCode"
               Css="@_basicCss">
        <Description>
            Use <code>BhFieldset</code> and <code>BhLegend</code> to group a set of
            form controls together with a title. The fieldset uses the native
            <code>&lt;fieldset&gt;</code> element while the legend renders as a
            <code>&lt;div&gt;</code> (since native <code>&lt;legend&gt;</code> is
            notoriously hard to style).
        </Description>
        <LiveContent>
            <BhFieldset class="fieldset">
                <div class="fieldset-header">
                    <BhLegend class="fieldset-legend">Shipping details</BhLegend>
                    <p class="fieldset-hint">Where should we deliver your order?</p>
                </div>

                <BhField class="field">
                    <BhLabel class="field-label">Street address</BhLabel>
                    <BhInput name="address" placeholder="123 Main St" class="field-input" />
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Country</BhLabel>
                    <BhSelect name="country" class="field-input field-select">
                        <option>Canada</option>
                        <option>Mexico</option>
                        <option>United States</option>
                    </BhSelect>
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Delivery notes</BhLabel>
                    <BhTextarea name="notes" rows="3"
                               placeholder="Leave at front door…"
                               class="field-input field-textarea" />
                </BhField>
            </BhFieldset>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabling a fieldset"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on the <code>BhFieldset</code> to
            disable every form control inside. The fieldset, legend, and all
            nested fields receive <code>data-disabled</code> for CSS hooks, and
            the native <code>disabled</code> attribute on the fieldset prevents
            interaction.
        </Description>
        <LiveContent>
            <BhFieldset Disabled="true" class="fieldset">
                <div class="fieldset-header">
                    <BhLegend class="fieldset-legend">Account (locked)</BhLegend>
                    <p class="fieldset-hint">Verify your email to edit these fields.</p>
                </div>

                <BhField class="field">
                    <BhLabel class="field-label">Username</BhLabel>
                    <BhInput type="text" value="alice" class="field-input" />
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Email</BhLabel>
                    <BhInput type="email" value="alice@example.com" class="field-input" />
                </BhField>
            </BhFieldset>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Toggling at runtime"
               Code="@_toggleCode"
               Css="@_toggleCss">
        <Description>
            Bind <code>Disabled</code> to a state value to enable or disable the
            entire group dynamically. Every nested input reflects the change
            through both the native <code>disabled</code> attribute and
            <code>data-disabled</code>.
        </Description>
        <LiveContent>
            <div class="fieldset-toolbar">
                <span class="fieldset-status" data-active="@(!_disabled)">
                    <span class="fieldset-status-dot"></span>
                    @(_disabled ? "Read-only" : "Editing")
                </span>
                <BhButton class="btn" OnClick="@(() => _disabled = !_disabled)">
                    @(_disabled ? "Enable" : "Disable")
                </BhButton>
            </div>

            <BhFieldset Disabled="_disabled" class="fieldset">
                <div class="fieldset-header">
                    <BhLegend class="fieldset-legend">Profile</BhLegend>
                    <p class="fieldset-hint">Shown publicly on your profile page.</p>
                </div>

                <BhField class="field">
                    <BhLabel class="field-label">Display name</BhLabel>
                    <BhInput type="text" placeholder="Alice Anderson" class="field-input" />
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Bio</BhLabel>
                    <BhTextarea rows="2" placeholder="Tell us about yourself…"
                               class="field-input field-textarea" />
                </BhField>
            </BhFieldset>
        </LiveContent>
    </DemoBlock>
</div>

