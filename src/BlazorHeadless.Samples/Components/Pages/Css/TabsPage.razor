    private const string _tabsCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.tabs {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.tab-list {
    display: flex;
    border-bottom: 1px solid #e4e4e7;
    gap: 0.25rem;
}

.tab {
    all: unset;
    padding: 0.6rem 1rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: #71717a;
    cursor: pointer;
    border-bottom: 2px solid transparent;
    transition: color 150ms ease, border-color 150ms ease;
    box-sizing: border-box;
}

.tab:hover                  { color: #18181b; }
.tab:focus-visible          { outline: 2px solid #2563eb; outline-offset: -2px; border-radius: 0.25rem; }

/* Hooks emitted by BhTab */
.tab[data-state="active"]   { color: #2563eb; border-bottom-color: #2563eb; }
.tab[data-disabled]         { opacity: 0.4; cursor: not-allowed; }

.tab-panel {
    padding: 0.5rem 0;
    color: #18181b;
}
""";

    private const string _verticalCss = """
/* Reuses .tabs / .tab / .tab-panels styles from the Basic demo.
   When Vertical="true" the root and tablist receive data-orientation="vertical",
   which we use to flip the layout. */
.tabs[data-orientation="vertical"] {
    flex-direction: row;
    align-items: flex-start;
    gap: 1.5rem;
}

.tabs[data-orientation="vertical"] .tab-list {
    flex-direction: column;
    border-bottom: none;
    border-right: 1px solid #e4e4e7;
    min-width: 12rem;
}

.tabs[data-orientation="vertical"] .tab {
    border-bottom: none;
    border-right: 2px solid transparent;
    text-align: start;
}

.tabs[data-orientation="vertical"] .tab[data-state="active"] {
    border-right-color: #2563eb;
    border-bottom-color: transparent;
}

.tabs[data-orientation="vertical"] .tab-panels { flex: 1 1 auto; }
""";

    private const string _disabledCss = """
/* Hooks emitted when a tab is disabled */
.tab[data-disabled] {
    opacity: 0.4;
    cursor: not-allowed;
}

/* Arrow-key navigation skips disabled tabs automatically — no JS needed. */
""";

    private const string _renderContextCss = """
/* The Tab render-prop context exposes IsSelected so you can style children
   based on the parent tab's state. */
.badge {
    margin-left: 0.5rem;
    padding: 0.05rem 0.4rem;
    background: #e4e4e7;
    color: #52525b;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 600;
}

.badge-active {
    background: #2563eb;
    color: #fff;
}
""";

