@page "/tabs"
@rendermode InteractiveServer

<PageTitle>Tabs — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Tabs</h1>
        <p>An accessible tab group with roving tabindex, full keyboard navigation, and zero visual opinion.</p>
        <SectionSwitcher Slug="tabs" />
    </header>

    <DemoBlock Title="Basic Tabs"
               Code="@_basicCode"
               Css="@_tabsCss">
        <Description>
            Click a tab or use Left / Right arrow keys, Home, and End to navigate. Disabled tabs are skipped automatically.
            ARIA roles, <code>aria-selected</code>, <code>aria-controls</code>, and <code>aria-labelledby</code> are wired automatically.
        </Description>
        <LiveContent>
            <BhTabGroup class="tabs">
                <BhTabList class="tab-list">
                    <BhTab class="tab">Account</BhTab>
                    <BhTab class="tab">Profile</BhTab>
                    <BhTab class="tab">Notifications</BhTab>
                </BhTabList>
                <BhTabPanels class="tab-panels">
                    <BhTabPanel class="tab-panel">
                        <h3>Account</h3>
                        <p>Manage your account settings and preferences.</p>
                    </BhTabPanel>
                    <BhTabPanel class="tab-panel">
                        <h3>Profile</h3>
                        <p>Update your public profile information.</p>
                    </BhTabPanel>
                    <BhTabPanel class="tab-panel">
                        <h3>Notifications</h3>
                        <p>Choose what alerts you'd like to receive.</p>
                    </BhTabPanel>
                </BhTabPanels>
            </BhTabGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Vertical Orientation"
               Code="@_verticalCode"
               Css="@_verticalCss">
        <Description>
            Set <code>Vertical="true"</code> to render tabs in a column.
            Arrow-key navigation switches to Up / Down, and the root and tablist
            both emit <code>data-orientation="vertical"</code> for CSS layout hooks.
        </Description>
        <LiveContent>
            <BhTabGroup Vertical="true" class="tabs tabs-vertical">
                <BhTabList class="tab-list">
                    <BhTab class="tab">General</BhTab>
                    <BhTab class="tab">Security</BhTab>
                    <BhTab class="tab">Integrations</BhTab>
                </BhTabList>
                <BhTabPanels class="tab-panels">
                    <BhTabPanel class="tab-panel">
                        <h3>General</h3>
                        <p>Application-wide settings.</p>
                    </BhTabPanel>
                    <BhTabPanel class="tab-panel">
                        <h3>Security</h3>
                        <p>Two-factor auth, sessions, and audit log.</p>
                    </BhTabPanel>
                    <BhTabPanel class="tab-panel">
                        <h3>Integrations</h3>
                        <p>Connect third-party services.</p>
                    </BhTabPanel>
                </BhTabPanels>
            </BhTabGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Manual Activation"
               Code="@_manualCode">
        <Description>
            With <code>Manual="true"</code> arrow keys only move keyboard focus; press
            Space or Enter to activate the focused tab. Useful when activating a tab is
            expensive (loads data, navigates, etc.) — try it: focus a tab, then arrow
            without selecting.
        </Description>
        <LiveContent>
            <BhTabGroup Manual="true" class="tabs">
                <BhTabList class="tab-list">
                    <BhTab class="tab">Inbox</BhTab>
                    <BhTab class="tab">Sent</BhTab>
                    <BhTab class="tab">Drafts</BhTab>
                    <BhTab class="tab">Archive</BhTab>
                </BhTabList>
                <BhTabPanels class="tab-panels">
                    <BhTabPanel class="tab-panel"><p>Inbox content</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Sent content</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Drafts content</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Archive content</p></BhTabPanel>
                </BhTabPanels>
            </BhTabGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Tab"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on individual tabs. Arrow-key navigation
            skips disabled tabs, and the disabled tab still receives <code>data-disabled</code>
            for CSS hooks.
        </Description>
        <LiveContent>
            <BhTabGroup class="tabs">
                <BhTabList class="tab-list">
                    <BhTab class="tab">Free</BhTab>
                    <BhTab class="tab">Pro</BhTab>
                    <BhTab class="tab" Disabled="true">Enterprise (coming soon)</BhTab>
                </BhTabList>
                <BhTabPanels class="tab-panels">
                    <BhTabPanel class="tab-panel"><p>Free plan features.</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Pro plan features.</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Enterprise plan features.</p></BhTabPanel>
                </BhTabPanels>
            </BhTabGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Render Context (state-driven content)"
               Code="@_renderContextCode"
               Css="@_renderContextCss">
        <Description>
            <code>BhTab</code> exposes a <code>BhTabRenderContext</code> via
            <code>Context="t"</code> so you can render badges, icons, or active
            indicators driven by the tab's own state.
        </Description>
        <LiveContent>
            <BhTabGroup class="tabs">
                <BhTabList class="tab-list">
                    <BhTab class="tab" Context="t">
                        <span>Messages</span>
                        <span class="badge @(t.IsSelected ? "badge-active" : "")">12</span>
                    </BhTab>
                    <BhTab class="tab" Context="t">
                        <span>Mentions</span>
                        <span class="badge @(t.IsSelected ? "badge-active" : "")">3</span>
                    </BhTab>
                    <BhTab class="tab" Context="t">
                        <span>All</span>
                    </BhTab>
                </BhTabList>
                <BhTabPanels class="tab-panels">
                    <BhTabPanel class="tab-panel"><p>Direct messages</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Mentions of you</p></BhTabPanel>
                    <BhTabPanel class="tab-panel"><p>Everything together</p></BhTabPanel>
                </BhTabPanels>
            </BhTabGroup>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Controlled"
               Code="@_controlledCode"
               Css="@_controlledCss">
        <Description>
            Drive selection externally with <code>SelectedIndex</code> and
            <code>OnSelectedIndexChange</code>. The buttons below select tabs programmatically.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; width:100%">
                <div class="demo-row">
                    @for (var i = 0; i < 3; i++)
                    {
                        var captured = i;
                        <BhButton OnClick="() => selectedIndex = captured"
                                 class="@(selectedIndex == captured ? "btn btn-primary" : "btn")">
                            Select tab @(captured + 1)
                        </BhButton>
                    }
                    <span class="demo-output">SelectedIndex: <strong>@selectedIndex</strong></span>
                </div>

                <BhTabGroup SelectedIndex="@selectedIndex"
                           OnSelectedIndexChange="i => selectedIndex = i"
                           class="tabs">
                    <BhTabList class="tab-list">
                        <BhTab class="tab">Tab 1</BhTab>
                        <BhTab class="tab">Tab 2</BhTab>
                        <BhTab class="tab">Tab 3</BhTab>
                    </BhTabList>
                    <BhTabPanels class="tab-panels">
                        <BhTabPanel class="tab-panel"><p>First panel</p></BhTabPanel>
                        <BhTabPanel class="tab-panel"><p>Second panel</p></BhTabPanel>
                        <BhTabPanel class="tab-panel"><p>Third panel</p></BhTabPanel>
                    </BhTabPanels>
                </BhTabGroup>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

