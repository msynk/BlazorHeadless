    private string? profile = "Benoit";
    private readonly string[] profiles = ["Andy", "Benoit", "Luis"];

    // ── Editor ─────────────────────────────────────────────────────────────────

    private bool lineNumbers = true;
    private bool wordWrap;
    private bool statusBar = true;
    private string? zoom = "100";
    private string? editorTheme = "Light";
    private readonly string[] zoomLevels = ["90", "100", "125"];
    private readonly string[] editorThemes = ["Light", "Dark", "Sepia"];

    private readonly string[] editorLines =
    [
        "// Use the View and Theme menus to restyle this editor.",
        "public sealed class Greeter",
