.menubar-code[data-wrap] .menubar-line-text { white-space: pre-wrap; }

.menubar-statusbar {
    display: flex;
    gap: 0.75rem;
    padding: 0.35rem 1rem;
    border-top: 1px solid rgba(127, 127, 127, 0.2);
    font-size: 0.72rem;
    opacity: 0.75;
}
""";

