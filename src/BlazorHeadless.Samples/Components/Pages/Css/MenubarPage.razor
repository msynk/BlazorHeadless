@page "/menubar"
@rendermode InteractiveServer

<PageTitle>Menubar — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Menubar</h1>
        <p>A desktop-style application menu bar — menus, submenus, checkable items and keyboard shortcuts — with zero visual opinion.</p>
        <SectionSwitcher Slug="menubar" />
    </header>

    <DemoBlock Title="Application menubar"
               Code="@_appCode"
               Css="@_appCss">
        <Description>
            The WAI-ARIA menubar pattern: the bar is a single tab stop, ← / → move between menus (and switch the
            open one), ↓ / Enter / Space open a menu, ↑ / ↓, Home / End and typeahead move inside it, → / ← open
            and close submenus, and Escape closes. Once a menu is open, hovering another trigger switches to it.
            Checkbox (<code>menuitemcheckbox</code>) and radio (<code>menuitemradio</code>) items keep the menu
            open and show their state through <code>BhMenuItemIndicator</code>; <code>BhMenuLabel</code> names its
            <code>BhMenuGroup</code>. The shortcuts are just text.
        </Description>
        <LiveContent>
            <BhMenubar class="menubar" aria-label="Application">
                <BhMenu>
                    <BhMenuButton class="menubar-trigger">File</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem OnClick='@(() => Log("New Tab"))' class="menubar-item">
                            New Tab <span class="menubar-shortcut">⌘T</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("New Window"))' class="menubar-item">
                            New Window <span class="menubar-shortcut">⌘N</span>
                        </BhMenuItem>
                        <BhMenuItem Disabled="true" class="menubar-item">New Incognito Window</BhMenuItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuSub>
                            <BhMenuSubTrigger class="menubar-item">
                                Share <span class="menubar-chevron" aria-hidden="true">›</span>
                            </BhMenuSubTrigger>
                            <BhMenuSubContent class="menubar-content">
                                <BhMenuItem OnClick='@(() => Log("Email Link"))' class="menubar-item">Email Link</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Messages"))' class="menubar-item">Messages</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Notes"))' class="menubar-item">Notes</BhMenuItem>
                            </BhMenuSubContent>
                        </BhMenuSub>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Print"))' class="menubar-item">
                            Print… <span class="menubar-shortcut">⌘P</span>
                        </BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu>
                    <BhMenuButton class="menubar-trigger">Edit</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem OnClick='@(() => Log("Undo"))' class="menubar-item">
                            Undo <span class="menubar-shortcut">⌘Z</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("Redo"))' class="menubar-item">
                            Redo <span class="menubar-shortcut">⇧⌘Z</span>
                        </BhMenuItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuSub>
                            <BhMenuSubTrigger class="menubar-item">
                                Find <span class="menubar-chevron" aria-hidden="true">›</span>
                            </BhMenuSubTrigger>
                            <BhMenuSubContent class="menubar-content">
                                <BhMenuItem OnClick='@(() => Log("Search the Web"))' class="menubar-item">Search the Web…</BhMenuItem>
                                <BhMenuSeparator class="menubar-separator" />
                                <BhMenuItem OnClick='@(() => Log("Find"))' class="menubar-item">
                                    Find… <span class="menubar-shortcut">⌘F</span>
                                </BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Find Next"))' class="menubar-item">
                                    Find Next <span class="menubar-shortcut">⌘G</span>
                                </BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Find Previous"))' class="menubar-item">
                                    Find Previous <span class="menubar-shortcut">⇧⌘G</span>
                                </BhMenuItem>
                            </BhMenuSubContent>
                        </BhMenuSub>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Cut"))' class="menubar-item">
                            Cut <span class="menubar-shortcut">⌘X</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("Copy"))' class="menubar-item">
                            Copy <span class="menubar-shortcut">⌘C</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("Paste"))' class="menubar-item">
                            Paste <span class="menubar-shortcut">⌘V</span>
                        </BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu>
                    <BhMenuButton class="menubar-trigger">View</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuCheckboxItem @bind-Checked="showBookmarks" class="menubar-item menubar-item-inset">
                            <BhMenuItemIndicator class="menubar-indicator">✓</BhMenuItemIndicator>
                            Always Show Bookmarks Bar <span class="menubar-shortcut">⇧⌘B</span>
                        </BhMenuCheckboxItem>
                        <BhMenuCheckboxItem @bind-Checked="showFullUrls" class="menubar-item menubar-item-inset">
                            <BhMenuItemIndicator class="menubar-indicator">✓</BhMenuItemIndicator>
                            Always Show Full URLs
                        </BhMenuCheckboxItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Reload"))' class="menubar-item menubar-item-inset">
                            Reload <span class="menubar-shortcut">⌘R</span>
                        </BhMenuItem>
                        <BhMenuItem Disabled="true" class="menubar-item menubar-item-inset">
                            Force Reload <span class="menubar-shortcut">⇧⌘R</span>
                        </BhMenuItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Toggle Fullscreen"))' class="menubar-item menubar-item-inset">Toggle Fullscreen</BhMenuItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Hide Sidebar"))' class="menubar-item menubar-item-inset">Hide Sidebar</BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu>
                    <BhMenuButton class="menubar-trigger">Profiles</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuGroup>
                            <BhMenuLabel class="menubar-label">Switch profile</BhMenuLabel>
                            <BhMenuRadioGroup @bind-Value="profile">
                                @foreach (var name in profiles)
                                {
                                    <BhMenuRadioItem Value="@name" class="menubar-item menubar-item-inset">
                                        <BhMenuItemIndicator class="menubar-indicator"><span class="menubar-dot"></span></BhMenuItemIndicator>
                                        @name
                                    </BhMenuRadioItem>
                                }
                            </BhMenuRadioGroup>
                        </BhMenuGroup>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Edit profile"))' class="menubar-item menubar-item-inset">Edit…</BhMenuItem>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Add Profile"))' class="menubar-item menubar-item-inset">Add Profile…</BhMenuItem>
                    </BhMenuItems>
                </BhMenu>
            </BhMenubar>

            <span class="demo-output">
                Last action: <strong>@(lastAction ?? "(none)")</strong> ·
                Bookmarks bar: <strong>@(showBookmarks ? "on" : "off")</strong> ·
                Profile: <strong>@profile</strong>
            </span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Checkbox and radio items driving the UI"
               Code="@_editorCode"
               Css="@_editorCss">
        <Description>
            Checkable items are just bound state. <code>@@bind-Checked</code> on <code>BhMenuCheckboxItem</code> and
            <code>@@bind-Value</code> on <code>BhMenuRadioGroup</code> drive the editor below — toggle line numbers, word
            wrap and the status bar, change the zoom or the theme. The menu stays open while you toggle so you can
            see each change; set <code>CloseOnSelect="true"</code> on an item to close it instead.
        </Description>
        <LiveContent>
            <div class="menubar-window">
                <BhMenubar class="menubar" aria-label="Editor">
                    <BhMenu>
                        <BhMenuButton class="menubar-trigger">View</BhMenuButton>
                        <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                            <BhMenuCheckboxItem @bind-Checked="lineNumbers" class="menubar-item menubar-item-inset">
                                <BhMenuItemIndicator class="menubar-indicator">✓</BhMenuItemIndicator>
                                Line Numbers
                            </BhMenuCheckboxItem>
                            <BhMenuCheckboxItem @bind-Checked="wordWrap" class="menubar-item menubar-item-inset">
                                <BhMenuItemIndicator class="menubar-indicator">✓</BhMenuItemIndicator>
                                Word Wrap <span class="menubar-shortcut">⌥Z</span>
                            </BhMenuCheckboxItem>
                            <BhMenuCheckboxItem @bind-Checked="statusBar" class="menubar-item menubar-item-inset">
                                <BhMenuItemIndicator class="menubar-indicator">✓</BhMenuItemIndicator>
                                Status Bar
                            </BhMenuCheckboxItem>
                            <BhMenuSeparator class="menubar-separator" />
                            <BhMenuGroup>
                                <BhMenuLabel class="menubar-label">Zoom</BhMenuLabel>
                                <BhMenuRadioGroup @bind-Value="zoom">
                                    @foreach (var level in zoomLevels)
                                    {
                                        <BhMenuRadioItem Value="@level" class="menubar-item menubar-item-inset">
                                            <BhMenuItemIndicator class="menubar-indicator"><span class="menubar-dot"></span></BhMenuItemIndicator>
                                            @(level)%
                                        </BhMenuRadioItem>
                                    }
                                </BhMenuRadioGroup>
                            </BhMenuGroup>
                        </BhMenuItems>
                    </BhMenu>
                    <BhMenu>
                        <BhMenuButton class="menubar-trigger">Theme</BhMenuButton>
                        <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                            <BhMenuRadioGroup @bind-Value="editorTheme" AriaLabel="Color theme">
                                @foreach (var option in editorThemes)
                                {
                                    <BhMenuRadioItem Value="@option" class="menubar-item menubar-item-inset">
                                        <BhMenuItemIndicator class="menubar-indicator"><span class="menubar-dot"></span></BhMenuItemIndicator>
                                        @option
                                    </BhMenuRadioItem>
                                }
                            </BhMenuRadioGroup>
                        </BhMenuItems>
                    </BhMenu>
                </BhMenubar>

                <div class="menubar-editor" data-theme="@editorTheme">
                    <div class="menubar-code" tabindex="0" role="region" aria-label="Editor preview" data-wrap="@wordWrap" style="font-size: @(zoom)%">
                        @for (var i = 0; i < editorLines.Length; i++)
                        {
                            <div class="menubar-line">
                                @if (lineNumbers)
                                {
                                    <span class="menubar-line-number">@(i + 1)</span>
                                }
                                <span class="menubar-line-text">@editorLines[i]</span>
                            </div>
                        }
                    </div>
                    @if (statusBar)
                    {
                        <div class="menubar-statusbar">
                            <span>Ln 4, Col 18</span><span>UTF-8</span><span>@(zoom)%</span><span>@editorTheme</span>
                        </div>
                    }
                </div>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Nested submenus"
               Code="@_submenusCode"
               Css="@_submenusCss">
        <Description>
            Nest <code>BhMenuSub</code> (a <code>BhMenuSubTrigger</code> plus a <code>BhMenuSubContent</code>) to any
            depth. Hovering opens a submenu after <code>OpenDelay</code>, and a <code>CloseDelay</code> grace period lets
            the pointer travel diagonally into it. → / Enter / Space open a submenu and focus its first item, ← / Escape
            close it and return to the trigger; on an item without a submenu, → moves on to the next menu of the bar.
            Submenu triggers expose <code>aria-haspopup</code>, <code>aria-expanded</code> and <code>data-state</code>.
        </Description>
        <LiveContent>
            <BhMenubar class="menubar" aria-label="Document">
                <BhMenu>
                    <BhMenuButton class="menubar-trigger">Insert</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem OnClick='@(() => Log("Insert image"))' class="menubar-item">Image…</BhMenuItem>
                        <BhMenuSub>
                            <BhMenuSubTrigger class="menubar-item">
                                Table <span class="menubar-chevron" aria-hidden="true">›</span>
                            </BhMenuSubTrigger>
                            <BhMenuSubContent class="menubar-content">
                                <BhMenuItem OnClick='@(() => Log("Insert 2 × 2 table"))' class="menubar-item">2 × 2</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Insert 3 × 3 table"))' class="menubar-item">3 × 3</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Insert 4 × 4 table"))' class="menubar-item">4 × 4</BhMenuItem>
                                <BhMenuSeparator class="menubar-separator" />
                                <BhMenuItem OnClick='@(() => Log("Insert custom table"))' class="menubar-item">Custom size…</BhMenuItem>
                            </BhMenuSubContent>
                        </BhMenuSub>
                        <BhMenuSub>
                            <BhMenuSubTrigger class="menubar-item">
                                Shape <span class="menubar-chevron" aria-hidden="true">›</span>
                            </BhMenuSubTrigger>
                            <BhMenuSubContent class="menubar-content">
                                <BhMenuItem OnClick='@(() => Log("Insert rectangle"))' class="menubar-item">Rectangle</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Insert ellipse"))' class="menubar-item">Ellipse</BhMenuItem>
                                <BhMenuSub>
                                    <BhMenuSubTrigger class="menubar-item">
                                        Arrow <span class="menubar-chevron" aria-hidden="true">›</span>
                                    </BhMenuSubTrigger>
                                    <BhMenuSubContent class="menubar-content">
                                        <BhMenuItem OnClick='@(() => Log("Insert straight arrow"))' class="menubar-item">Straight</BhMenuItem>
                                        <BhMenuItem OnClick='@(() => Log("Insert curved arrow"))' class="menubar-item">Curved</BhMenuItem>
                                        <BhMenuItem OnClick='@(() => Log("Insert elbow arrow"))' class="menubar-item">Elbow</BhMenuItem>
                                    </BhMenuSubContent>
                                </BhMenuSub>
                            </BhMenuSubContent>
                        </BhMenuSub>
                        <BhMenuSeparator class="menubar-separator" />
                        <BhMenuItem OnClick='@(() => Log("Insert page break"))' class="menubar-item">
                            Page Break <span class="menubar-shortcut">⌘↵</span>
                        </BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu>
                    <BhMenuButton class="menubar-trigger">Share</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem OnClick='@(() => Log("Copy link"))' class="menubar-item">
                            Copy Link <span class="menubar-shortcut">⌘L</span>
                        </BhMenuItem>
                        <BhMenuSub OpenDelay="0" CloseDelay="500">
                            <BhMenuSubTrigger class="menubar-item">
                                Send To <span class="menubar-chevron" aria-hidden="true">›</span>
                            </BhMenuSubTrigger>
                            <BhMenuSubContent class="menubar-content">
                                <BhMenuItem OnClick='@(() => Log("Send by email"))' class="menubar-item">Email</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Send as message"))' class="menubar-item">Messages</BhMenuItem>
                                <BhMenuItem OnClick='@(() => Log("Send to team chat"))' class="menubar-item">Team Chat</BhMenuItem>
                            </BhMenuSubContent>
                        </BhMenuSub>
                    </BhMenuItems>
                </BhMenu>
            </BhMenubar>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled menus and items"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            A disabled <code>BhMenu</code> can't be opened and ← / → skip over it; disabled items stay visible (with
            <code>data-disabled</code> and <code>aria-disabled</code>) but arrow keys and typeahead pass them by.
            <code>Loop="false"</code> stops the arrow keys at the first and last menu instead of wrapping. Items can
            also render as links with <code>As="a"</code> — Enter follows the link.
        </Description>
        <LiveContent>
            <BhMenubar Loop="false" class="menubar" aria-label="Read-only document">
                <BhMenu>
                    <BhMenuButton class="menubar-trigger">File</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem OnClick='@(() => Log("Open"))' class="menubar-item">
                            Open… <span class="menubar-shortcut">⌘O</span>
                        </BhMenuItem>
                        <BhMenuItem Disabled="true" class="menubar-item">
                            Save <span class="menubar-shortcut">⌘S</span>
                        </BhMenuItem>
                        <BhMenuItem Disabled="true" class="menubar-item">
                            Save As… <span class="menubar-shortcut">⇧⌘S</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("Export PDF"))' class="menubar-item">Export as PDF</BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu Disabled="true">
                    <BhMenuButton class="menubar-trigger">Edit</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem class="menubar-item">Undo</BhMenuItem>
                    </BhMenuItems>
                </BhMenu>

                <BhMenu>
                    <BhMenuButton class="menubar-trigger">Help</BhMenuButton>
                    <BhMenuItems Anchor="@(new BhAnchorOptions { To = "bottom start", Gap = 6 })" class="menubar-content">
                        <BhMenuItem As="a" href="https://www.w3.org/WAI/ARIA/apg/patterns/menubar/" target="_blank" rel="noopener"
                                    class="menubar-item">
                            Menubar pattern (APG) <span class="menubar-shortcut" aria-hidden="true">↗</span>
                        </BhMenuItem>
                        <BhMenuItem OnClick='@(() => Log("About"))' class="menubar-item">About</BhMenuItem>
                    </BhMenuItems>
                </BhMenu>
            </BhMenubar>

            <span class="demo-output">Last action: <strong>@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private string? lastAction;

    private void Log(string action) => lastAction = action;

    // ── Application menubar ────────────────────────────────────────────────────

    private bool showBookmarks;
