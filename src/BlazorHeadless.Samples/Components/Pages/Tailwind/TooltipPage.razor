        <BhTooltipContent Anchor="@(new BhAnchorOptions { To = "bottom", Gap = 6 })" class="z-50 rounded-md bg-zinc-900 px-2.5 py-1 text-xs text-zinc-50 shadow-md">Bottom</BhTooltipContent>
    </BhTooltip>

    <BhTooltip class="inline-block">
        <BhTooltipTrigger class="inline-flex items-center gap-2 rounded-lg border border-zinc-300 bg-white px-3.5 py-2 text-sm font-medium cursor-pointer">Left</BhTooltipTrigger>
