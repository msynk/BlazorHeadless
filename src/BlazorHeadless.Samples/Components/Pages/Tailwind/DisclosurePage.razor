@page "/tw/disclosure"
@rendermode InteractiveServer

<PageTitle>Disclosure — BlazorHeadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Disclosure</h1>
        <p class="mt-2 text-zinc-500">A single show/hide region toggled by a button — the simplest collapsible primitive.</p>
        <TwSectionSwitcher Slug="disclosure" />
    </header>

    <TwDemoBlock Title="Basic Disclosure" Code="@_basicCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-expanded</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-controls</code>, and <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">aria-labelledby</code> are wired automatically.
        </Description>
        <LiveContent>
            <BhDisclosure class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <BhDisclosureButton class="flex w-full cursor-pointer items-center justify-between border-0 bg-transparent px-5 py-3.5 text-base font-medium outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                    Show details
                </BhDisclosureButton>
                <BhDisclosurePanel>
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                        Disclosure is the simpler sibling of Accordion: one trigger, one panel, zero coordination.
                    </div>
                </BhDisclosurePanel>
            </BhDisclosure>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Default Open" Code="@_defaultOpenCode">
        <Description>Set <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">DefaultOpen="true"</code> to render open initially.</Description>
        <LiveContent>
            <BhDisclosure DefaultOpen="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <BhDisclosureButton class="flex w-full cursor-pointer items-center justify-between border-0 bg-transparent px-5 py-3.5 text-base font-medium outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                    Already open
                </BhDisclosureButton>
                <BhDisclosurePanel>
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                        I'm open by default. Click the button to close me.
                    </div>
                </BhDisclosurePanel>
            </BhDisclosure>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Render Context (rotating chevron + Close)" Code="@_renderContextCode">
        <Description>
            All three components expose a <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">BhDisclosureRenderContext</code>. Use it to drive UI from the open state and call <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">d.Close()</code>.
        </Description>
        <LiveContent>
            <BhDisclosure class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <BhDisclosureButton class="flex w-full cursor-pointer items-center justify-between border-0 bg-transparent px-5 py-3.5 text-base font-medium outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none"
                                    Context="d">
                    <span>What's inside?</span>
                    <span class="@($"text-zinc-500 transition-transform duration-200 {(d.IsOpen ? "rotate-180" : "")}")">▾</span>
                </BhDisclosureButton>
                <BhDisclosurePanel Context="d">
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">
                        <p>You can close me from inside the panel:</p>
                        <button class="mt-3 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100" @onclick="d.Close">Close panel</button>
                    </div>
                </BhDisclosurePanel>
            </BhDisclosure>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Disabled" Code="@_disabledCode">
        <Description><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-disabled:</code> dims the row.</Description>
        <LiveContent>
            <BhDisclosure Disabled="true" class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                <BhDisclosureButton class="flex w-full cursor-pointer items-center justify-between border-0 bg-transparent px-5 py-3.5 text-base font-medium outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                    Can't toggle me
                </BhDisclosureButton>
                <BhDisclosurePanel>
                    <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">You'll never see this content.</div>
                </BhDisclosurePanel>
            </BhDisclosure>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Controlled" Code="@_controlledCode">
        <Description>External <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Open</code> + <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnOpenChange</code>.</Description>
        <LiveContent>
            <div class="flex flex-col gap-4 w-full">
                <div class="flex flex-wrap items-center gap-3">
                    <BhButton OnClick="ToggleControlled"
                              class="rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium hover:bg-zinc-100">
                        Toggle from outside
                    </BhButton>
                    <span class="text-sm text-zinc-500">Open: @controlledOpen.ToString().ToLowerInvariant()</span>
                </div>

                <BhDisclosure Open="controlledOpen" OnOpenChange="v => controlledOpen = v"
                              class="w-full overflow-hidden rounded-lg border border-zinc-200 bg-white data-disabled:bg-zinc-50">
                    <BhDisclosureButton class="flex w-full cursor-pointer items-center justify-between border-0 bg-transparent px-5 py-3.5 text-base font-medium outline-none hover:bg-zinc-100 focus-visible:outline-2 focus-visible:outline-offset-[-2px] focus-visible:outline-blue-600 data-state-open:bg-zinc-100 data-disabled:opacity-50 data-disabled:cursor-not-allowed data-disabled:pointer-events-none">
                        Internal trigger
                    </BhDisclosureButton>
                    <BhDisclosurePanel>
                        <div class="border-t border-zinc-200 px-5 py-3.5 text-sm text-zinc-500">Either trigger updates the same state.</div>
                    </BhDisclosurePanel>
                </BhDisclosure>
            </div>
        </LiveContent>
    </TwDemoBlock>
</div>

