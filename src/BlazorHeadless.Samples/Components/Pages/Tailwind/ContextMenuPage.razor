@page "/tw/context-menu"
@rendermode InteractiveServer

<PageTitle>Context Menu — BlazorHeadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Context Menu</h1>
        <p class="mt-2 text-zinc-500">A menu at the pointer, opened by right-click. Keyboard navigation, typeahead, and viewport collision handling.</p>
        <TwSectionSwitcher Slug="context-menu" />
    </header>

    <TwDemoBlock Title="Basic Context Menu" Code="@_basicCode">
        <Description>Right-click the trigger; navigate with arrow keys / Home / End / Enter / Escape / typeahead.</Description>
        <LiveContent>
            <BhContextMenu>
                <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-context-menu transition-colors data-state-open:border-blue-600 data-state-open:text-blue-700">
                    Right-click here
                </BhContextMenuTrigger>
                <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                    <BhContextMenuItem OnClick='@(() => Log("Back"))'    class="@_itemClass" Label="Back">Back</BhContextMenuItem>
                    <BhContextMenuItem OnClick='@(() => Log("Forward"))' class="@_itemClass" Label="Forward" Disabled="true">Forward</BhContextMenuItem>
                    <BhContextMenuItem OnClick='@(() => Log("Reload"))'  class="@_itemClass" Label="Reload">Reload</BhContextMenuItem>
                </BhContextMenuContent>
            </BhContextMenu>
            <span class="text-sm text-zinc-500">Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Labels, groups and separators" Code="@_structuredCode">
        <Description><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Label</code>, <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Group</code> and <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Separator</code> structure the menu; they're skipped by keyboard nav.</Description>
        <LiveContent>
            <BhContextMenu>
                <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-context-menu transition-colors data-state-open:border-blue-600 data-state-open:text-blue-700">
                    Right-click for a structured menu
                </BhContextMenuTrigger>
                <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                    <BhContextMenuLabel class="@_labelClass">Edit</BhContextMenuLabel>
                    <BhContextMenuGroup class="list-none">
                        <BhContextMenuItem OnClick='@(() => Log("Cut"))'   class="@_itemClass" Label="Cut">Cut <span class="ml-auto text-xs text-zinc-500">⌘X</span></BhContextMenuItem>
                        <BhContextMenuItem OnClick='@(() => Log("Copy"))'  class="@_itemClass" Label="Copy">Copy <span class="ml-auto text-xs text-zinc-500">⌘C</span></BhContextMenuItem>
                        <BhContextMenuItem OnClick='@(() => Log("Paste"))' class="@_itemClass" Label="Paste">Paste <span class="ml-auto text-xs text-zinc-500">⌘V</span></BhContextMenuItem>
                    </BhContextMenuGroup>
                    <BhContextMenuSeparator class="my-1 block h-px bg-zinc-200 list-none" />
                    <BhContextMenuLabel class="@_labelClass">Danger zone</BhContextMenuLabel>
                    <BhContextMenuItem OnClick='@(() => Log("Delete"))' class="@_dangerItemClass" Label="Delete">Delete</BhContextMenuItem>
                </BhContextMenuContent>
            </BhContextMenu>
            <span class="text-sm text-zinc-500">Last action: <strong class="text-zinc-900">@(lastAction ?? "(none)")</strong></span>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Disabled menu" Code="@_disabledCode">
        <Description><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Disabled="true"</code> on the root lets the native browser menu through.</Description>
        <LiveContent>
            <BhContextMenu Disabled="true">
                <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-default">
                    Right-click here (disabled — native menu shows)
                </BhContextMenuTrigger>
                <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
                    <BhContextMenuItem OnClick='@(() => Log("Never"))' class="@_itemClass" Label="Never">Never runs</BhContextMenuItem>
                </BhContextMenuContent>
            </BhContextMenu>
        </LiveContent>
    </TwDemoBlock>
</div>

@code {
    private string? lastAction;

    private void Log(string action) => lastAction = action;

    private const string _itemClass =
        "flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none " +
        "data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed";

    private const string _dangerItemClass =
        "flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-red-600 list-none " +
        "data-active:bg-red-50 data-active:text-red-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed";

    private const string _labelClass =
        "px-2.5 pt-1.5 pb-0.5 text-xs font-semibold uppercase tracking-wider text-zinc-500 list-none";

    private const string _basicCode = """
<BhContextMenu>
    <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-context-menu transition-colors data-state-open:border-blue-600 data-state-open:text-blue-700">
        Right-click here
    </BhContextMenuTrigger>
    <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
        <BhContextMenuItem OnClick='@(() => Log("Back"))'    class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Back">Back</BhContextMenuItem>
        <BhContextMenuItem OnClick='@(() => Log("Forward"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Forward" Disabled="true">Forward</BhContextMenuItem>
        <BhContextMenuItem OnClick='@(() => Log("Reload"))'  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700 data-disabled:opacity-40 data-disabled:cursor-not-allowed" Label="Reload">Reload</BhContextMenuItem>
    </BhContextMenuContent>
</BhContextMenu>

@code {
    private string? lastAction;
    private void Log(string action) => lastAction = action;
}
""";

    private const string _structuredCode = """
<BhContextMenu>
    <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-context-menu transition-colors data-state-open:border-blue-600 data-state-open:text-blue-700">
        Right-click for a structured menu
    </BhContextMenuTrigger>
    <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
        <BhContextMenuLabel class="px-2.5 pt-1.5 pb-0.5 text-xs font-semibold uppercase tracking-wider text-zinc-500 list-none">Edit</BhContextMenuLabel>
        <BhContextMenuGroup class="list-none">
            <BhContextMenuItem OnClick='@(() => Log("Cut"))'   class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700" Label="Cut">Cut <span class="ml-auto text-xs text-zinc-500">⌘X</span></BhContextMenuItem>
            <BhContextMenuItem OnClick='@(() => Log("Copy"))'  class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700" Label="Copy">Copy <span class="ml-auto text-xs text-zinc-500">⌘C</span></BhContextMenuItem>
            <BhContextMenuItem OnClick='@(() => Log("Paste"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-zinc-900 list-none data-active:bg-blue-50 data-active:text-blue-700" Label="Paste">Paste <span class="ml-auto text-xs text-zinc-500">⌘V</span></BhContextMenuItem>
        </BhContextMenuGroup>
        <BhContextMenuSeparator class="my-1 block h-px bg-zinc-200 list-none" />
        <BhContextMenuLabel class="px-2.5 pt-1.5 pb-0.5 text-xs font-semibold uppercase tracking-wider text-zinc-500 list-none">Danger zone</BhContextMenuLabel>
        <BhContextMenuItem OnClick='@(() => Log("Delete"))' class="flex items-center gap-2 rounded-md px-2.5 py-2 text-sm cursor-pointer text-red-600 list-none data-active:bg-red-50 data-active:text-red-700" Label="Delete">Delete</BhContextMenuItem>
    </BhContextMenuContent>
</BhContextMenu>
""";

    private const string _disabledCode = """
<BhContextMenu Disabled="true">
    <BhContextMenuTrigger class="grid place-items-center w-full min-h-36 px-8 py-8 rounded-xl border-2 border-dashed border-zinc-300 text-sm text-zinc-500 select-none cursor-default">
        Right-click here (disabled — native menu shows)
    </BhContextMenuTrigger>
    <BhContextMenuContent class="z-[9999] m-0 min-w-44 list-none rounded-lg border border-zinc-200 bg-white p-1 shadow-lg outline-none">
        <BhContextMenuItem OnClick='@(() => Log("Never"))' class="..." Label="Never">Never runs</BhContextMenuItem>
    </BhContextMenuContent>
</BhContextMenu>
""";
}
