@page "/tw/checkbox"
@rendermode InteractiveServer

<PageTitle>Checkbox — BlazorHeadless · Tailwind</PageTitle>

<div class="mx-auto w-full max-w-3xl px-6 py-12 pb-24">
    <header class="mb-12">
        <h1 class="text-3xl font-bold tracking-tight text-zinc-900">Checkbox</h1>
        <p class="mt-2 text-zinc-500">An accessible tri-state checkbox primitive styled with Tailwind utilities.</p>
        <TwSectionSwitcher Slug="checkbox" />
    </header>

    <TwDemoBlock Title="Basic Checkbox (Uncontrolled)" Code="@_basicCode">
        <Description>Native <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">&lt;button&gt;</code> with <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">role="checkbox"</code>. Click or press Space to toggle.</Description>
        <LiveContent>
            <BhCheckbox class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                        Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </BhCheckbox>
            <BhCheckbox DefaultChecked="true"
                        class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                        Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </BhCheckbox>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Controlled" Code="@_controlledCode">
        <Description>External <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Checked</code> + <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">OnCheckedChange</code>.</Description>
        <LiveContent>
            <div class="flex items-center gap-4">
                <BhCheckbox Checked="@acceptedTerms" OnCheckedChange="v => acceptedTerms = v"
                            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                            Context="c">
                    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                </BhCheckbox>
                <span class="text-sm text-zinc-500">
                    Terms accepted: <strong class="text-zinc-900">@(acceptedTerms ? "yes" : "no")</strong>
                </span>
                <BhButton OnClick="() => acceptedTerms = !acceptedTerms"
                          class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">
                    Toggle from outside
                </BhButton>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Disabled" Code="@_disabledCode">
        <Description>The custom <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-disabled:</code> variant applies the disabled visuals.</Description>
        <LiveContent>
            <BhCheckbox Disabled="true"
                        class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                        Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </BhCheckbox>
            <BhCheckbox DefaultChecked="true" Disabled="true"
                        class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                        Context="c">
                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
            </BhCheckbox>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Indeterminate (Select All pattern)" Code="@_indeterminateCode">
        <Description>
            <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">data-state-indeterminate:</code> styles the mixed state — the parent reflects partial child selection.
        </Description>
        <LiveContent>
            <div class="flex flex-col gap-2">
                <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                    <BhCheckbox Checked="@SelectAllChecked" Indeterminate="@SelectAllIndeterminate" OnCheckedChange="HandleSelectAll"
                                class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                                Context="c">
                        @if (c.IsIndeterminate) { <span class="text-base leading-none font-bold">–</span> }
                        else if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                    </BhCheckbox>
                    <strong>Select all</strong>
                </label>
                <div class="flex flex-col gap-1.5 ml-6">
                    @for (var i = 0; i < items.Length; i++)
                    {
                        var captured = i;
                        <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                            <BhCheckbox Checked="@items[captured]" OnCheckedChange="v => HandleItemChange(captured, v)"
                                        class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                                        Context="c">
                                @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                            </BhCheckbox>
                            <span>Item @(captured + 1)</span>
                        </label>
                    }
                </div>
            </div>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="With label" Code="@_labelCode">
        <Description>Wrap in <code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">&lt;label&gt;</code> for clickable text.</Description>
        <LiveContent>
            <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                <BhCheckbox class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                            Context="c">
                    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                </BhCheckbox>
                <span>Send me product updates</span>
            </label>
        </LiveContent>
    </TwDemoBlock>

    <TwDemoBlock Title="Form Submission" Code="@_formCode">
        <Description><code class="rounded bg-zinc-100 px-1.5 py-0.5 text-sm">Name</code> renders an adjacent hidden input.</Description>
        <LiveContent>
            <form @onsubmit="HandleFormSubmit" @onsubmit:preventDefault="true"
                  class="flex flex-col items-start gap-2">
                <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                    <BhCheckbox Name="agree" Value="yes"
                                class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                                Context="c">
                        @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                    </BhCheckbox>
                    <span>I agree to the terms</span>
                </label>
                <button type="submit"
                        class="inline-flex items-center gap-2 rounded-lg border border-blue-600 bg-blue-600 px-3 py-1.5 text-sm font-medium text-white cursor-pointer hover:bg-blue-700">
                    Submit
                </button>
                @if (lastSubmitted is not null)
                {
                    <span class="text-sm text-zinc-500">@lastSubmitted</span>
                }
            </form>
        </LiveContent>
    </TwDemoBlock>
</div>

@code {
    private bool acceptedTerms;
    private bool[] items = new[] { false, false, false };
    private string? lastSubmitted;

    private bool SelectAllChecked => items.All(x => x);
    private bool SelectAllIndeterminate => items.Any(x => x) && !SelectAllChecked;

    private void HandleSelectAll(bool checkAll)
    {
        for (var i = 0; i < items.Length; i++)
            items[i] = checkAll;
    }

    private void HandleItemChange(int index, bool value) => items[index] = value;

    private void HandleFormSubmit() =>
        lastSubmitted = "(submitted — when checked, the form posts agree=yes)";

    private const string _basicCode = """
<BhCheckbox class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
            Context="c">
    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
</BhCheckbox>

<BhCheckbox DefaultChecked="true"
            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
            Context="c">
    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
</BhCheckbox>
""";

    private const string _controlledCode = """
<div class="flex items-center gap-4">
    <BhCheckbox Checked="@acceptedTerms" OnCheckedChange="v => acceptedTerms = v"
                class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                Context="c">
        @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
    </BhCheckbox>
    <span class="text-sm text-zinc-500">
        Terms accepted: <strong class="text-zinc-900">@(acceptedTerms ? "yes" : "no")</strong>
    </span>
    <BhButton OnClick="() => acceptedTerms = !acceptedTerms"
              class="inline-flex items-center gap-2 rounded-lg border border-zinc-200 bg-white px-3 py-1.5 text-sm font-medium text-zinc-900 cursor-pointer hover:bg-zinc-100">
        Toggle from outside
    </BhButton>
</div>

@code {
    private bool acceptedTerms;
}
""";

    private const string _disabledCode = """
<BhCheckbox Disabled="true"
            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
            Context="c">
    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
</BhCheckbox>

<BhCheckbox DefaultChecked="true" Disabled="true"
            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
            Context="c">
    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
</BhCheckbox>
""";

    private const string _indeterminateCode = """
<div class="flex flex-col gap-2">
    <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
        <BhCheckbox Checked="@SelectAllChecked" Indeterminate="@SelectAllIndeterminate" OnCheckedChange="HandleSelectAll"
                    class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-state-indeterminate:bg-blue-600 data-state-indeterminate:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                    Context="c">
            @if (c.IsIndeterminate) { <span class="text-base leading-none font-bold">–</span> }
            else if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
        </BhCheckbox>
        <strong>Select all</strong>
    </label>
    <div class="flex flex-col gap-1.5 ml-6">
        @for (var i = 0; i < items.Length; i++)
        {
            var captured = i;
            <label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
                <BhCheckbox Checked="@items[captured]" OnCheckedChange="v => HandleItemChange(captured, v)"
                            class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                            Context="c">
                    @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
                </BhCheckbox>
                <span>Item @(captured + 1)</span>
            </label>
        }
    </div>
</div>

@code {
    private bool[] items = new[] { false, false, false };

    private bool SelectAllChecked => items.All(x => x);
    private bool SelectAllIndeterminate => items.Any(x => x) && !SelectAllChecked;

    private void HandleSelectAll(bool checkAll)
    {
        for (var i = 0; i < items.Length; i++) items[i] = checkAll;
    }

    private void HandleItemChange(int index, bool value) => items[index] = value;
}
""";

    private const string _labelCode = """
<label class="inline-flex items-center gap-2 cursor-pointer text-sm select-none">
    <BhCheckbox class="inline-flex h-[1.15rem] w-[1.15rem] flex-shrink-0 items-center justify-center rounded border border-zinc-300 bg-white text-white cursor-pointer transition-colors outline-none hover:border-zinc-400 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-blue-600 data-state-checked:bg-blue-600 data-state-checked:border-blue-600 data-disabled:opacity-50 data-disabled:cursor-not-allowed"
                Context="c">
        @if (c.IsChecked) { <span class="text-sm leading-none">✓</span> }
