@page "/transition"
@rendermode InteractiveServer

<PageTitle>Transition — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Transition</h1>
        <p>CSS class-based enter/leave animations with automatic lifecycle management.</p>
    </header>

    <DemoBlock Title="Fade"
               Code="@_fadeCode"
               Css="@_fadeCss">
        <Description>
            Toggle the panel. On enter: <code>opacity-0</code> → <code>opacity-100</code>.
            On leave: <code>opacity-100</code> → <code>opacity-0</code>. The element is
            unmounted after the leave animation completes.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <HButton OnClick="() => showFade = !showFade" class="btn btn-primary">
                    @(showFade ? "Hide" : "Show")
                </HButton>

                <HTransition Show="showFade"
                             Enter="transition-opacity duration-300"
                             EnterFrom="opacity-0"
                             EnterTo="opacity-100"
                             Leave="transition-opacity duration-200"
                             LeaveFrom="opacity-100"
                             LeaveTo="opacity-0"
                             class="transition-demo-box">
                    <p>I fade in and out.</p>
                </HTransition>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Scale + Fade"
               Code="@_scaleCode"
               Css="@_scaleCss">
        <Description>
            Combine opacity and transform for a more dynamic entrance. The
            <code>Enter</code> / <code>Leave</code> classes set the transition
            properties and duration; <code>From</code> / <code>To</code> set the
            start and end states.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <HButton OnClick="() => showScale = !showScale" class="btn btn-primary">
                    @(showScale ? "Hide" : "Show")
                </HButton>

                <HTransition Show="showScale"
                             Enter="transition-all duration-300 ease-out"
                             EnterFrom="opacity-0 scale-95"
                             EnterTo="opacity-100 scale-100"
                             Leave="transition-all duration-200 ease-in"
                             LeaveFrom="opacity-100 scale-100"
                             LeaveTo="opacity-0 scale-95"
                             class="transition-demo-box">
                    <p>I scale and fade.</p>
                </HTransition>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Slide Down"
               Code="@_slideCode"
               Css="@_slideCss">
        <Description>
            A slide-down reveal using <code>max-height</code> and <code>overflow: hidden</code>.
            Useful for accordion-style content reveals.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <HButton OnClick="() => showSlide = !showSlide" class="btn btn-primary">
                    @(showSlide ? "Hide" : "Show")
                </HButton>

                <HTransition Show="showSlide"
                             Enter="slide-enter"
                             EnterFrom="slide-enter-from"
                             EnterTo="slide-enter-to"
                             Leave="slide-leave"
                             LeaveFrom="slide-leave-from"
                             LeaveTo="slide-leave-to"
                             class="transition-demo-box slide-box">
                    <p>I slide down from zero height.</p>
                </HTransition>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="With Appear"
               Code="@_appearCode"
               Css="@_appearCss">
        <Description>
            Set <code>Appear="true"</code> to run the enter transition on initial mount.
            Without it, elements that start with <code>Show="true"</code> appear instantly.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <HButton OnClick="() => showAppear = !showAppear" class="btn btn-primary">
                    @(showAppear ? "Hide" : "Show")
                </HButton>

                <HTransition Show="showAppear"
                             Appear="true"
                             Enter="transition-all duration-500 ease-out"
                             EnterFrom="opacity-0 translate-y-4"
                             EnterTo="opacity-100 translate-y-0"
                             Leave="transition-all duration-300 ease-in"
                             LeaveFrom="opacity-100 translate-y-0"
                             LeaveTo="opacity-0 translate-y-4"
                             class="transition-demo-box">
                    <p>I animate on first mount too.</p>
                </HTransition>
            </div>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Lifecycle Callbacks"
               Code="@_callbackCode"
               Css="@_callbackCss">
        <Description>
            Use <code>BeforeEnter</code>, <code>AfterEnter</code>,
            <code>BeforeLeave</code>, <code>AfterLeave</code> to run logic at
            each phase of the transition.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; align-items:flex-start;">
                <HButton OnClick="() => showCallbacks = !showCallbacks" class="btn btn-primary">
                    @(showCallbacks ? "Hide" : "Show")
                </HButton>

                <HTransition Show="showCallbacks"
                             Enter="transition-opacity duration-300"
                             EnterFrom="opacity-0"
                             EnterTo="opacity-100"
                             Leave="transition-opacity duration-200"
                             LeaveFrom="opacity-100"
                             LeaveTo="opacity-0"
                             BeforeEnter='@(() => Log("BeforeEnter"))'
                             AfterEnter='@(() => Log("AfterEnter"))'
                             BeforeLeave='@(() => Log("BeforeLeave"))'
                             AfterLeave='@(() => Log("AfterLeave"))'
                             class="transition-demo-box">
                    <p>Check the log below.</p>
                </HTransition>

                <div class="demo-output" style="white-space:pre-wrap;">@callbackLog</div>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private bool showFade;
    private bool showScale;
    private bool showSlide;
    private bool showAppear = true;
    private bool showCallbacks;
    private string callbackLog = "";

    private void Log(string msg) => callbackLog += msg + "\n";

    // ── Source snippets ───────────────────────────────────────────────────────

    private const string _fadeCode = """
<HTransition Show="@isOpen"
             Enter="transition-opacity duration-300"
             EnterFrom="opacity-0"
             EnterTo="opacity-100"
             Leave="transition-opacity duration-200"
             LeaveFrom="opacity-100"
             LeaveTo="opacity-0">
    <div class="panel">I fade in and out.</div>
</HTransition>
""";

    private const string _scaleCode = """
<HTransition Show="@isOpen"
             Enter="transition-all duration-300 ease-out"
             EnterFrom="opacity-0 scale-95"
             EnterTo="opacity-100 scale-100"
             Leave="transition-all duration-200 ease-in"
             LeaveFrom="opacity-100 scale-100"
             LeaveTo="opacity-0 scale-95">
    <div class="panel">I scale and fade.</div>
</HTransition>
""";

    private const string _slideCode = """
<HTransition Show="@isOpen"
             Enter="slide-enter"
             EnterFrom="slide-enter-from"
             EnterTo="slide-enter-to"
             Leave="slide-leave"
             LeaveFrom="slide-leave-from"
             LeaveTo="slide-leave-to">
    <div class="panel">I slide down.</div>
</HTransition>
""";

    private const string _appearCode = """
<HTransition Show="@isOpen"
             Appear="true"
             Enter="transition-all duration-500 ease-out"
             EnterFrom="opacity-0 translate-y-4"
             EnterTo="opacity-100 translate-y-0"
             Leave="transition-all duration-300 ease-in"
             LeaveFrom="opacity-100 translate-y-0"
             LeaveTo="opacity-0 translate-y-4">
    <div class="panel">I animate on first mount too.</div>
</HTransition>

@* Without Appear="true", elements that start with Show="true" appear instantly. *@
""";

    private const string _callbackCode = """
<HTransition Show="@isOpen"
             Enter="transition-opacity duration-300"
             EnterFrom="opacity-0"
             EnterTo="opacity-100"
             Leave="transition-opacity duration-200"
             LeaveFrom="opacity-100"
             LeaveTo="opacity-0"
             BeforeEnter="() => Log(\"BeforeEnter\")"
             AfterEnter="() => Log(\"AfterEnter\")"
             BeforeLeave="() => Log(\"BeforeLeave\")"
             AfterLeave="() => Log(\"AfterLeave\")">
    <div class="panel">Check the log.</div>
</HTransition>
""";

    private const string _fadeCss = """
/* Utility classes — you can use Tailwind or write your own */
.transition-opacity { transition-property: opacity; }
.duration-300       { transition-duration: 300ms; }
.duration-200       { transition-duration: 200ms; }
.opacity-0          { opacity: 0; }
.opacity-100        { opacity: 1; }
""";

    private const string _scaleCss = """
.transition-all { transition-property: all; }
.ease-out       { transition-timing-function: ease-out; }
.ease-in        { transition-timing-function: ease-in; }
.scale-95       { transform: scale(0.95); }
.scale-100      { transform: scale(1); }
""";

    private const string _slideCss = """
/* Slide-down using max-height */
.slide-box          { overflow: hidden; }
.slide-enter        { transition: max-height 300ms ease-out, opacity 300ms ease-out; }
.slide-enter-from   { max-height: 0; opacity: 0; }
.slide-enter-to     { max-height: 10rem; opacity: 1; }
.slide-leave        { transition: max-height 200ms ease-in, opacity 200ms ease-in; }
.slide-leave-from   { max-height: 10rem; opacity: 1; }
.slide-leave-to     { max-height: 0; opacity: 0; }
""";

    private const string _appearCss = """
.translate-y-4  { transform: translateY(1rem); }
.translate-y-0  { transform: translateY(0); }
.duration-500   { transition-duration: 500ms; }
""";

    private const string _callbackCss = """
/* Same fade classes as the first demo — no extra CSS needed for callbacks. */
""";
}
