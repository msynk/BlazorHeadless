@page "/field"
@rendermode InteractiveServer

<PageTitle>Field / Input — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Field / Input</h1>
        <p>Form primitives with auto-wired ARIA labels, descriptions, and validation state.</p>
    </header>

    <DemoBlock Title="Basic Field"
               Code="@_basicCode"
               Css="@_fieldCss">
        <Description>
            Wrap a label, input, and description in an <code>BhField</code>. The label's
            <code>for</code>, the input's <code>id</code>, and the description's
            <code>aria-describedby</code> are all wired automatically — no manual id management.
        </Description>
        <LiveContent>
            <BhField class="field">
                <BhLabel class="field-label">Email</BhLabel>
                <BhInput type="email" placeholder="you@example.com" class="field-input" />
                <BhDescription class="field-description">We'll never share your email.</BhDescription>
            </BhField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Textarea"
               Code="@_textareaCode"
               Css="@_textareaCss">
        <Description>
            <code>BhTextarea</code> works identically to <code>BhInput</code> — same ARIA
            wiring, same data attributes. Standard HTML attributes like <code>rows</code>
            pass through.
        </Description>
        <LiveContent>
            <BhField class="field">
                <BhLabel class="field-label">Bio</BhLabel>
                <BhTextarea rows="3" placeholder="Tell us about yourself…" class="field-input field-textarea" />
                <BhDescription class="field-description">Max 280 characters.</BhDescription>
            </BhField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Select"
               Code="@_selectCode"
               Css="@_selectCss">
        <Description>
            <code>BhSelect</code> renders a native <code>&lt;select&gt;</code> with the same
            auto-wired ARIA. Place <code>&lt;option&gt;</code> elements inside.
        </Description>
        <LiveContent>
            <BhField class="field">
                <BhLabel class="field-label">Country</BhLabel>
                <BhSelect class="field-input field-select">
                    <option value="">Choose…</option>
                    <option value="us">United States</option>
                    <option value="gb">United Kingdom</option>
                    <option value="fr">France</option>
                    <option value="de">Germany</option>
                </BhSelect>
                <BhDescription class="field-description">Where you're based.</BhDescription>
            </BhField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Field"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on the <code>BhField</code> to disable all
            children at once. The field, label, and input all receive <code>data-disabled</code>
            for CSS hooks.
        </Description>
        <LiveContent>
            <BhField Disabled="true" class="field">
                <BhLabel class="field-label">Username</BhLabel>
                <BhInput type="text" value="alice" class="field-input" />
                <BhDescription class="field-description">Cannot be changed.</BhDescription>
            </BhField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Invalid Field"
               Code="@_invalidCode"
               Css="@_invalidCss">
        <Description>
            Set <code>Invalid="true"</code> on the <code>BhField</code> to mark the input
            as invalid. The input receives <code>aria-invalid="true"</code> and
            <code>data-invalid</code> for CSS hooks. Use the description to show an error message.
        </Description>
        <LiveContent>
            <BhField Invalid="true" class="field">
                <BhLabel class="field-label">Password</BhLabel>
                <BhInput type="password" value="123" class="field-input" />
                <BhDescription class="field-description field-error">
                    Password must be at least 8 characters.
                </BhDescription>
            </BhField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multiple Fields (form layout)"
               Code="@_formCode"
               Css="@_formCss">
        <Description>
            Compose multiple <code>BhField</code> components into a form. Each field
            manages its own id namespace — no collisions.
        </Description>
        <LiveContent>
            <form class="field-form" @onsubmit:preventDefault>
                <BhField class="field">
                    <BhLabel class="field-label">First name</BhLabel>
                    <BhInput type="text" placeholder="Alice" class="field-input" />
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Last name</BhLabel>
                    <BhInput type="text" placeholder="Anderson" class="field-input" />
                </BhField>

                <BhField class="field">
                    <BhLabel class="field-label">Email</BhLabel>
                    <BhInput type="email" placeholder="alice@example.com" class="field-input" />
                    <BhDescription class="field-description">Your work email.</BhDescription>
                </BhField>

                <BhButton Type="submit" class="btn btn-primary">Submit</BhButton>
            </form>
        </LiveContent>
    </DemoBlock>
</div>

