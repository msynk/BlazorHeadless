@page "/field"
@rendermode InteractiveServer

<PageTitle>Field / Input — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Field / Input</h1>
        <p>Form primitives with auto-wired ARIA labels, descriptions, and validation state.</p>
    </header>

    <DemoBlock Title="Basic Field"
               Code="@_basicCode"
               Css="@_fieldCss">
        <Description>
            Wrap a label, input, and description in an <code>HField</code>. The label's
            <code>for</code>, the input's <code>id</code>, and the description's
            <code>aria-describedby</code> are all wired automatically — no manual id management.
        </Description>
        <LiveContent>
            <HField class="field">
                <HLabel class="field-label">Email</HLabel>
                <HInput type="email" placeholder="you@example.com" class="field-input" />
                <HDescription class="field-description">We'll never share your email.</HDescription>
            </HField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Textarea"
               Code="@_textareaCode"
               Css="@_textareaCss">
        <Description>
            <code>HTextarea</code> works identically to <code>HInput</code> — same ARIA
            wiring, same data attributes. Standard HTML attributes like <code>rows</code>
            pass through.
        </Description>
        <LiveContent>
            <HField class="field">
                <HLabel class="field-label">Bio</HLabel>
                <HTextarea rows="3" placeholder="Tell us about yourself…" class="field-input field-textarea" />
                <HDescription class="field-description">Max 280 characters.</HDescription>
            </HField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Select"
               Code="@_selectCode"
               Css="@_selectCss">
        <Description>
            <code>HSelect</code> renders a native <code>&lt;select&gt;</code> with the same
            auto-wired ARIA. Place <code>&lt;option&gt;</code> elements inside.
        </Description>
        <LiveContent>
            <HField class="field">
                <HLabel class="field-label">Country</HLabel>
                <HSelect class="field-input field-select">
                    <option value="">Choose…</option>
                    <option value="us">United States</option>
                    <option value="gb">United Kingdom</option>
                    <option value="fr">France</option>
                    <option value="de">Germany</option>
                </HSelect>
                <HDescription class="field-description">Where you're based.</HDescription>
            </HField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled Field"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on the <code>HField</code> to disable all
            children at once. The field, label, and input all receive <code>data-disabled</code>
            for CSS hooks.
        </Description>
        <LiveContent>
            <HField Disabled="true" class="field">
                <HLabel class="field-label">Username</HLabel>
                <HInput type="text" value="alice" class="field-input" />
                <HDescription class="field-description">Cannot be changed.</HDescription>
            </HField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Invalid Field"
               Code="@_invalidCode"
               Css="@_invalidCss">
        <Description>
            Set <code>Invalid="true"</code> on the <code>HField</code> to mark the input
            as invalid. The input receives <code>aria-invalid="true"</code> and
            <code>data-invalid</code> for CSS hooks. Use the description to show an error message.
        </Description>
        <LiveContent>
            <HField Invalid="true" class="field">
                <HLabel class="field-label">Password</HLabel>
                <HInput type="password" value="123" class="field-input" />
                <HDescription class="field-description field-error">
                    Password must be at least 8 characters.
                </HDescription>
            </HField>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Multiple Fields (form layout)"
               Code="@_formCode"
               Css="@_formCss">
        <Description>
            Compose multiple <code>HField</code> components into a form. Each field
            manages its own id namespace — no collisions.
        </Description>
        <LiveContent>
            <form class="field-form" @onsubmit:preventDefault>
                <HField class="field">
                    <HLabel class="field-label">First name</HLabel>
                    <HInput type="text" placeholder="Alice" class="field-input" />
                </HField>

                <HField class="field">
                    <HLabel class="field-label">Last name</HLabel>
                    <HInput type="text" placeholder="Anderson" class="field-input" />
                </HField>

                <HField class="field">
                    <HLabel class="field-label">Email</HLabel>
                    <HInput type="email" placeholder="alice@example.com" class="field-input" />
                    <HDescription class="field-description">Your work email.</HDescription>
                </HField>

                <HButton Type="submit" class="btn btn-primary">Submit</HButton>
            </form>
        </LiveContent>
    </DemoBlock>
</div>

