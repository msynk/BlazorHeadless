@page "/disclosure"
@rendermode InteractiveServer

<PageTitle>Disclosure — BlazorHeadless</PageTitle>

<div class="demo-page">
    <header class="demo-header">
        <h1>Disclosure</h1>
        <p>A single show/hide region toggled by a button — the simplest collapsible primitive.</p>
    </header>

    <DemoBlock Title="Basic Disclosure"
               Code="@_basicCode"
               Css="@_disclosureCss">
        <Description>
            Renders a button and a panel. Clicking the button toggles the panel.
            <code>aria-expanded</code>, <code>aria-controls</code>, and <code>aria-labelledby</code>
            are wired automatically.
        </Description>
        <LiveContent>
            <HDisclosure class="disclosure">
                <HDisclosureButton class="disclosure-button">
                    Show details
                </HDisclosureButton>
                <HDisclosurePanel class="disclosure-panel">
                    <div class="disclosure-body">
                        Disclosure is the simpler sibling of Accordion: one trigger, one panel,
                        zero coordination across siblings.
                    </div>
                </HDisclosurePanel>
            </HDisclosure>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Default Open"
               Code="@_defaultOpenCode"
               Css="@_defaultOpenCss">
        <Description>
            Set <code>DefaultOpen="true"</code> to render the panel open initially (uncontrolled).
        </Description>
        <LiveContent>
            <HDisclosure DefaultOpen="true" class="disclosure">
                <HDisclosureButton class="disclosure-button">
                    Already open
                </HDisclosureButton>
                <HDisclosurePanel class="disclosure-panel">
                    <div class="disclosure-body">
                        I'm open by default. Click the button to close me.
                    </div>
                </HDisclosurePanel>
            </HDisclosure>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Render Context (rotating chevron + Close)"
               Code="@_renderContextCode"
               Css="@_chevronCss">
        <Description>
            <code>HDisclosure</code>, <code>HDisclosureButton</code>, and <code>HDisclosurePanel</code>
            all expose a <code>DisclosureRenderContext</code> via <code>Context="d"</code>. Use it
            to drive UI from the open state and to call <code>d.Close()</code> from anywhere inside.
        </Description>
        <LiveContent>
            <HDisclosure class="disclosure">
                <HDisclosureButton class="disclosure-button" Context="d">
                    <span>What's inside?</span>
                    <span class="disclosure-chevron @(d.IsOpen ? "open" : "")">▾</span>
                </HDisclosureButton>
                <HDisclosurePanel class="disclosure-panel" Context="d">
                    <div class="disclosure-body">
                        <p>You can close me from inside the panel:</p>
                        <button class="btn" @onclick="d.Close">Close panel</button>
                    </div>
                </HDisclosurePanel>
            </HDisclosure>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Disabled"
               Code="@_disabledCode"
               Css="@_disabledCss">
        <Description>
            Set <code>Disabled="true"</code> on the root to block interaction. The button receives
            both the native <code>disabled</code> attribute and a <code>data-disabled</code> hook.
        </Description>
        <LiveContent>
            <HDisclosure Disabled="true" class="disclosure">
                <HDisclosureButton class="disclosure-button">
                    Can't toggle me
                </HDisclosureButton>
                <HDisclosurePanel class="disclosure-panel">
                    <div class="disclosure-body">You'll never see this content.</div>
                </HDisclosurePanel>
            </HDisclosure>
        </LiveContent>
    </DemoBlock>

    <DemoBlock Title="Controlled"
               Code="@_controlledCode"
               Css="@_controlledCss">
        <Description>
            Drive the open state externally with <code>Open</code> + <code>OnOpenChange</code>.
            The button below opens or closes the disclosure programmatically.
        </Description>
        <LiveContent>
            <div style="display:flex; flex-direction:column; gap:1rem; width:100%">
                <div class="demo-row">
                    <HButton OnClick="ToggleControlled" class="btn">
                        Toggle from outside
                    </HButton>
                    <span class="demo-output">Open: @controlledOpen.ToString().ToLowerInvariant()</span>
                </div>

                <HDisclosure Open="controlledOpen"
                             OnOpenChange="v => controlledOpen = v"
                             class="disclosure">
                    <HDisclosureButton class="disclosure-button">
                        Internal trigger
                    </HDisclosureButton>
                    <HDisclosurePanel class="disclosure-panel">
                        <div class="disclosure-body">
                            Either trigger updates the same state — fully controlled.
                        </div>
                    </HDisclosurePanel>
                </HDisclosure>
            </div>
        </LiveContent>
    </DemoBlock>
</div>

@code {
    private bool controlledOpen;

    private void ToggleControlled() => controlledOpen = !controlledOpen;

    // ── Source snippets shown alongside each live demo ─────────────────────────

    private const string _basicCode = """
<HDisclosure class="disclosure">
    <HDisclosureButton class="disclosure-button">
        Show details
    </HDisclosureButton>
    <HDisclosurePanel class="disclosure-panel">
        <div class="disclosure-body">…</div>
    </HDisclosurePanel>
</HDisclosure>
""";

    private const string _defaultOpenCode = """
<HDisclosure DefaultOpen="true" class="disclosure">
    <HDisclosureButton class="disclosure-button">Already open</HDisclosureButton>
    <HDisclosurePanel class="disclosure-panel">…</HDisclosurePanel>
</HDisclosure>
""";

    private const string _renderContextCode = """
<HDisclosure class="disclosure">
    <HDisclosureButton class="disclosure-button" Context="d">
        <span>What's inside?</span>
        <span class="disclosure-chevron @(d.IsOpen ? "open" : "")">▾</span>
    </HDisclosureButton>
    <HDisclosurePanel class="disclosure-panel" Context="d">
        <div class="disclosure-body">
            <button class="btn" @onclick="d.Close">Close panel</button>
        </div>
    </HDisclosurePanel>
</HDisclosure>
""";

    private const string _disabledCode = """
<HDisclosure Disabled="true" class="disclosure">
    <HDisclosureButton class="disclosure-button">Can't toggle me</HDisclosureButton>
    <HDisclosurePanel class="disclosure-panel">…</HDisclosurePanel>
</HDisclosure>
""";

    private const string _controlledCode = """
<HDisclosure Open="controlledOpen"
             OnOpenChange="v => controlledOpen = v"
             class="disclosure">
    <HDisclosureButton class="disclosure-button">Internal trigger</HDisclosureButton>
    <HDisclosurePanel class="disclosure-panel">…</HDisclosurePanel>
</HDisclosure>

@code {
    private bool controlledOpen;
}
""";

    private const string _disclosureCss = """
/* All styles are consumer-authored — the library ships zero CSS */
.disclosure {
    width: 100%;
    border: 1px solid #e4e4e7;
    border-radius: 0.5rem;
    overflow: hidden;
    background: #fff;
}

.disclosure-button {
    all: unset;
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 0.875rem 1.125rem;
    font-weight: 500;
    cursor: pointer;
    box-sizing: border-box;
}

.disclosure-button:hover                { background: #f4f4f5; }
.disclosure-button:focus-visible        { outline: 2px solid #2563eb; outline-offset: -2px; }
.disclosure-button[data-state="open"]   { background: #f4f4f5; }
.disclosure-button[data-disabled]       { opacity: 0.5; cursor: not-allowed; pointer-events: none; }

.disclosure-body {
    padding: 0.875rem 1.125rem 1rem;
    color: #71717a;
    border-top: 1px solid #e4e4e7;
}
""";

    private const string _chevronCss = """
/* Rotating chevron driven by DisclosureRenderContext.IsOpen */
.disclosure-chevron      { transition: transform 200ms ease; color: #71717a; }
.disclosure-chevron.open { transform: rotate(180deg); }
""";

    // The "Default Open", "Disabled", and "Controlled" demos all reuse the styles
    // from the basic demo above. The snippets below highlight only the demo-specific
    // selectors so it's clear which hooks drive each scenario.

    private const string _defaultOpenCss = """
/* Reuses the .disclosure / .disclosure-button styles from the Basic demo.
   When DefaultOpen="true" the button is rendered with data-state="open" on
   first paint so the open-state styles apply immediately. */
.disclosure-button[data-state="open"] { background: #f4f4f5; }
""";

    private const string _disabledCss = """
/* Hooks emitted when Disabled="true" */
.disclosure-button[data-disabled] {
    opacity: 0.5;
    cursor: not-allowed;
    pointer-events: none;
}

/* The root <HDisclosure> element also receives data-disabled — useful for
   dimming the entire region. */
.disclosure[data-disabled] {
    background: #fafafa;
}
""";

    private const string _controlledCss = """
/* Reuses the .disclosure / .disclosure-button styles from the Basic demo.
   Controlled mode adds no special CSS hooks — data-state simply reflects
   whatever Open value you bind to. */
""";
}
